+static int zeroflash_get_fw_image(void)
+{
+	int retval = 0;
+	struct ovt_tcm_hcd *tcm_hcd = zeroflash_hcd->tcm_hcd;
+	const struct firmware **p_fw_entry = NULL;
+	unsigned char *p_image_name;
+
+#if USE_OMNIVSION_IMG_FILE
+
+	int retry_cnt = 10;
+#endif
+
+	mutex_lock(&tcm_hcd->firmware_image_mutex);
+
+#if USE_OMNIVSION_IMG_FILE
+	switch (g_firmware_version_v2)
+	{
+	case 1:
+#ifdef CONFIG_SUPPORT_MULTI_FIRMWARE
+		if (tcm_hcd->request_fw_image_id == TEST_FIRMWARE) {
+			printk(" omnivision TEST FW version  success to enter\n");
+			p_fw_entry = &zeroflash_hcd->test_fw_entry;
+			p_image_name = TEST_FW_IMAGE_NAME;
+		} else if (tcm_hcd->request_fw_image_id == LPWG_FIRMWARE) {
+			printk(" omnivision  LPWG FW  version  success to enter\n");
+			p_fw_entry = &zeroflash_hcd->lpwg_fw_entry;
+			p_image_name = LPWG_FW_IMAGE_NAME;
+		} else
+#endif
+		{
+			printk(" omnivision FW image version  success to enter\n");
+			p_fw_entry = &zeroflash_hcd->fw_entry;
+			p_image_name = FW_IMAGE_NAME;
+		}
+		break;
+	case 2:
+#ifdef CONFIG_SUPPORT_MULTI_FIRMWARE
+		if (tcm_hcd->request_fw_image_id == TEST_FIRMWARE) {
+			printk(" omnivision TEST FW version  success to enter\n");
+			p_fw_entry = &zeroflash_hcd->test_fw_entry;
+			p_image_name = TEST_FW_IMAGE_NAME_LATTET;
+		} else if (tcm_hcd->request_fw_image_id == LPWG_FIRMWARE) {
+			printk(" omnivision  LPWG FW  version  success to enter\n");
+			p_fw_entry = &zeroflash_hcd->lpwg_fw_entry;
+			p_image_name = LPWG_FW_IMAGE_NAME_LATTET;
+		} else
+#endif
+		{
+			printk(" omnivision FW image version  success to enter\n");
+			p_fw_entry = &zeroflash_hcd->fw_entry;
+			p_image_name = FW_IMAGE_NAME_LATTET;
+		}
+		break;
+	case 3:
+#ifdef CONFIG_SUPPORT_MULTI_FIRMWARE
+		if (tcm_hcd->request_fw_image_id == TEST_FIRMWARE) {
+			printk(" omnivision TEST FW version  success to enter\n");
+			p_fw_entry = &zeroflash_hcd->test_fw_entry;
+			p_image_name = TEST_FW_IMAGE_NAME_NAIROBI;
+		} else if (tcm_hcd->request_fw_image_id == LPWG_FIRMWARE) {
+			printk(" omnivision  LPWG FW  version  success to enter\n");
+			p_fw_entry = &zeroflash_hcd->lpwg_fw_entry;
+			p_image_name = LPWG_FW_IMAGE_NAME_NAIROBI;
+		} else
+#endif
+		{
+			printk(" omnivision FW image version  success to enter\n");
+			p_fw_entry = &zeroflash_hcd->fw_entry;
+			p_image_name = FW_IMAGE_NAME_NAIROBI;
+		}
+		break;
+	default:
+		break;
+	}
+
+	if (p_fw_entry == NULL) {
+		LOGE(tcm_hcd->pdev->dev.parent, "p_fw_entry is not initialized\n");
+		mutex_unlock(&tcm_hcd->firmware_image_mutex);
+		return -EINVAL;
+	}
+
+	if (*p_fw_entry != NULL) {
+		release_firmware(*p_fw_entry);
+		*p_fw_entry = NULL;
+		zeroflash_hcd->image = NULL;
+	}
+	while(retry_cnt--) {
+		retval = request_firmware(p_fw_entry,
+			p_image_name,
+			tcm_hcd->pdev->dev.parent);
+		if (retval < 0) {
+			LOGE(tcm_hcd->pdev->dev.parent,
+				"Failed to request %s, retry_cnt:%d\n",
+				p_image_name, retry_cnt);
+			if (retry_cnt == 0) {
+				mutex_unlock(&tcm_hcd->firmware_image_mutex);
+				return retval;
+			}
+			msleep(1000);
+		} else {
+			break;
+		}
+	}
+
+	LOGD(tcm_hcd->pdev->dev.parent,
+	"Firmware image size = %d\n",
+	(unsigned int)(*p_fw_entry)->size);
+
+	zeroflash_hcd->image = (*p_fw_entry)->data;
+#else
+	switch (g_firmware_version_v2)
+	{
+	case 1:
+		zeroflash_hcd->image = omnivsion_image_array;
+		break;
+	case 2:
+		zeroflash_hcd->image = omnivsion_image_array;
+		break;
+	case 3:
+		zeroflash_hcd->image = omnivsion_image_array;
+		break;
+	default:
+		break;
+	}
+#endif
+
+	retval = zeroflash_parse_fw_image();
+	if (retval < 0) {
+		LOGE(tcm_hcd->pdev->dev.parent,
+				"Failed to parse firmware image\n");
+#if USE_OMNIVSION_IMG_FILE
+		release_firmware(*p_fw_entry);
+		*p_fw_entry = NULL;
+#endif
+		zeroflash_hcd->image = NULL;
+		mutex_unlock(&tcm_hcd->firmware_image_mutex);
+		return retval;
+	}
+	mutex_unlock(&tcm_hcd->firmware_image_mutex);
+	return 0;
+}
