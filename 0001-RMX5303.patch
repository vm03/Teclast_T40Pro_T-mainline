+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Mainline DRM panel driver derived from:
+ *   lcd_td4160b_dsjm_boe_mipi_hd.dtsi
+ *
+ * TD4160B DSJM BOE, 720x1604, 4-lane MIPI DSI, RGB888.
+ * The source DTS sets sprd,use-dcs-write, so initialization commands are
+ * sent using DCS writes. Command payloads and delays are kept from the DTS.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+#include <video/mipi_display.h>
+
+struct td4160b_cmd {
+	u16 delay_ms;
+	u16 len;
+	u8 data[256];
+};
+
+struct td4160b_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *avdd_gpio;
+	struct gpio_desc *avee_gpio;
+	struct regulator *supply;
+	struct backlight_device *backlight;
+	bool prepared;
+};
+
+static inline struct td4160b_panel *
+to_td4160b_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct td4160b_panel, panel);
+}
+
+static int td4160b_panel_power_on(struct td4160b_panel *ctx)
+{
+	int ret;
+
+	/* The downstream driver enables its regulator named "power" first. */
+	if (ctx->supply) {
+		ret = regulator_enable(ctx->supply);
+		if (ret) {
+			dev_err(&ctx->dsi->dev, "failed to enable panel supply: %d\n", ret);
+			return ret;
+		}
+	}
+
+	dev_info(&ctx->dsi->dev, "power-on: assert AVDD\n");
+	gpiod_set_value_cansleep(ctx->avdd_gpio, 1);
+	msleep(5);
+
+	dev_info(&ctx->dsi->dev, "power-on: assert AVEE\n");
+	gpiod_set_value_cansleep(ctx->avee_gpio, 1);
+	/* Downstream sequence waits 5 ms here (not 10 ms). */
+	msleep(5);
+	return 0;
+}
+
+static void td4160b_panel_power_off(struct td4160b_panel *ctx)
+{
+	dev_info(&ctx->dsi->dev, "power-off: deassert AVEE\n");
+	gpiod_set_value_cansleep(ctx->avee_gpio, 0);
+	msleep(5);
+
+	dev_info(&ctx->dsi->dev, "power-off: deassert AVDD\n");
+	gpiod_set_value_cansleep(ctx->avdd_gpio, 0);
+	msleep(5);
+
+}
+
+static void td4160b_panel_reset(struct td4160b_panel *ctx)
+{
+	/* sprd,reset-on-sequence = <1 5>, <0 5>, <1 30>. */
+	dev_info(&ctx->dsi->dev, "reset: sequence start\n");
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(5);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(5);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(30);
+	dev_info(&ctx->dsi->dev, "reset: sequence complete\n");
+}
+
+static void td4160b_panel_reset_off(struct td4160b_panel *ctx)
+{
+	/* sprd,reset-off-sequence = <0 5>. */
+	dev_info(&ctx->dsi->dev, "reset: assert reset (panel off)\n");
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(5);
+}
+
+static int td4160b_panel_write_commands(struct td4160b_panel *ctx,
+					const struct td4160b_cmd *cmds,
+					size_t count)
+{
+	size_t i;
+	ssize_t ret;
+
+	dev_info(&ctx->dsi->dev, "sending %zu DCS commands\n", count);
+	for (i = 0; i < count; i++) {
+		ret = mipi_dsi_dcs_write_buffer(ctx->dsi, cmds[i].data,
+						cmds[i].len);
+		if (ret < 0) {
+			dev_err(&ctx->dsi->dev,
+				"DCS command %zu (0x%02x) failed: %zd\n",
+				i, cmds[i].data[0], ret);
+			return ret;
+		}
+
+		if (cmds[i].delay_ms)
+			msleep(cmds[i].delay_ms);
+	}
+
+	dev_info(&ctx->dsi->dev, "DCS command sequence completed (%zu commands)\n", count);
+	return 0;
+}
