+{
+    char buf[128] = {0};
+	int retval;
+    if (copy_from_user(buf, buff, len)) {
+        return -EFAULT;
+    }
+
+	if ((buf[0] == '0') || (buf[0] == '1')) {
+        td4160_test_proc_ops.global_switch = 1;
+        td4160_test_proc_ops.direction = 1;
+        td4160_test_proc_ops.enable_direction = 5;
+        printk("omnivision direction Vertical screen\n");
+    } else if (buf[0] == '3') {
+        td4160_test_proc_ops.global_switch = 1;
+        td4160_test_proc_ops.direction = 3;
+        td4160_test_proc_ops.enable_direction = 3;
+        printk("omnivision direction Horizontal screen\n");
+    } else if (buf[0] == '4') {
+        td4160_test_proc_ops.global_switch = 1;
+        td4160_test_proc_ops.direction = 4;
+        td4160_test_proc_ops.enable_direction = 3;
+        printk("omnivision direction Horizontal screen\n");
+    } else {
+        LOGE(testing_hcd->tcm_hcd->pdev->dev.parent,"enable direction_write error\n");
+        return -EFAULT;
+    }
+
+    retval = ovt_tcm_set_dynamic_config_host_interface(DC_GRIP_SUPPRESSION_ENABLED, td4160_test_proc_ops.global_switch);
+    printk("omnivision charge_detect close:%d.\n", td4160_test_proc_ops.global_switch);
+    if (retval < 0) {
+        LOGE(testing_hcd->tcm_hcd->pdev->dev.parent,
+                "Failed to enable DC_GRIP_SUPPRESSION_ENABLED write\n");
+    }
+
+    retval = ovt_tcm_set_dynamic_config_host_interface(DC_ENABLE_ROATE_HORIZONTAL_LEVEL, td4160_test_proc_ops.direction);
+    printk("omnivision charge_detect close:%d.\n", td4160_test_proc_ops.direction);
+    if (retval < 0) {
+        LOGE(testing_hcd->tcm_hcd->pdev->dev.parent,
+                "Failed to enable DC_ENABLE_ROATE_HORIZONTAL_LEVEL write\n");
+    }
