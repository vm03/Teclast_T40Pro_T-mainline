+int ovt_tcm_bus_init_v2(void)
+{
+	return spi_register_driver(&ovt_tcm_spi_driver);
+}
+
+void ovt_tcm_bus_exit_v2(void)
+{
+	spi_unregister_driver(&ovt_tcm_spi_driver);
