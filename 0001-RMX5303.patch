+//if lcd request the gpio firstly, maybe lcd driver should provide a function to control tp reset
+void ovt_tcm_set_reset_gpio(int value)
+{
+	struct ovt_tcm_hcd *tcm_hcd;
+	tcm_hcd = g_tcm_hcd;
+
+	if (!tcm_hcd || tcm_hcd->ovt_tcm_driver_removing) {
+		return;
+	}
+
+	if (tcm_hcd && tcm_hcd->hw_if) {
+		const struct ovt_tcm_board_data *bdata = tcm_hcd->hw_if->bdata;
+		/* value is the physical level: 0 == reset asserted */
+		if (bdata->reset_gpiod) {
+			ovt_tcm_hw_reset_line(bdata, !value);
+			LOGN(tcm_hcd->pdev->dev.parent, "reset line %s\n",
+					value ? "released" : "asserted");
+		}
+	}
+}
