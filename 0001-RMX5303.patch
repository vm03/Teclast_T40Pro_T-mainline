+static ssize_t charge_detect_write(struct file *file, const char *buff,
+									size_t len, loff_t *pos)
+{
+    char buf[80] = {0};
+	int retval = 0;
+	struct ovt_tcm_hcd *tcm_hcd = testing_hcd->tcm_hcd;
+	if ((!tcm_hcd) || (tcm_hcd->ovt_tcm_driver_removing)) {
+		printk("omnivision tcm shutdown, do not set charger\n");
+		return 0;
+	}
+	if (copy_from_user(buf, buff, len)) {
+        return -EFAULT;
+    }
+    if (buf[0] == '0') {
+		td4160_test_proc_ops.charge_detect_val = 0;
+		retval = ovt_tcm_set_dynamic_config_host_interface(DC_CHARGER_CONNECTED, td4160_test_proc_ops.charge_detect_val);
+		printk("omnivision charge_detect close:%d.\n", td4160_test_proc_ops.charge_detect_val);
+		if (retval < 0) {
+			LOGE(tcm_hcd->pdev->dev.parent,
+					"omnivision Failed to charge_detect mode\n");
+		}
+	}
+	else if (buf[0] == '1') {
+		td4160_test_proc_ops.charge_detect_val = 1;
+		retval = ovt_tcm_set_dynamic_config_host_interface(DC_CHARGER_CONNECTED, td4160_test_proc_ops.charge_detect_val);
+		printk("omnivision charge_detect success:%d.\n", td4160_test_proc_ops.charge_detect_val);
+		if (retval < 0) {
+			LOGE(tcm_hcd->pdev->dev.parent,
+					"omnivision Failed to charge_detect mode\n");
+		}
+	}
+	return len;
+}
