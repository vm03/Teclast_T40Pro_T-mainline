+static ssize_t black_test_write(struct file *file, const char *buff,
+									size_t len, loff_t *pos)
+{
+	char buf[80] = {0};
+	int retval = 0;
+	struct ovt_tcm_hcd *tcm_hcd = testing_hcd->tcm_hcd;
+
+	if (copy_from_user(buf, buff, len)) {
+		return -EFAULT;
+	}
+
+	if (buf[0] == '0') {
+		touch_black_test = 0;
+	}
+	else if (buf[0] == '1') {
+		touch_black_test = 1;
+		wakeup_gesture_enabled_bak = testing_hcd->tcm_hcd->wakeup_gesture_enabled;
+		testing_hcd->tcm_hcd->wakeup_gesture_enabled = true;
+		retval = tcm_hcd->set_dynamic_config(tcm_hcd,
+		DC_IN_WAKEUP_GESTURE_MODE,
+		1);
+		printk("omnivision retval:%d.\n", retval);
+		if (retval < 0) {
+			LOGE(tcm_hcd->pdev->dev.parent,
+					"omnivision Failed to enable wakeup gesture mode\n");
+		}
+	}
+	return len;
+}
+
