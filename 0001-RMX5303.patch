+static int black_screen_test_function(void)
+{
+	int retval = 0;
+	int error_count_v2 = 0;
+	struct ovt_tcm_hcd *tcm_hcd = testing_hcd->tcm_hcd;
+
+
+	LOGN(tcm_hcd->pdev->dev.parent, "black_screen_test_function Start testing\n");
