+		snprintf(g_testing_output_buf_v2 + strlen(g_testing_output_buf_v2), OUTPUT_TO_CSV_STRING_LEN_v2 - strlen(g_testing_output_buf_v2), 
+			"start to do test,\n");
+
+		if (g_firmware_version_v2 == 1)
