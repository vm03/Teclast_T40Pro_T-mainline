+static void ovt_get_tp_fw_ver(struct ovt_tcm_hcd *tcm_hcd)
+{
+	static const char * const prefix[] = {
+		[0] = "",
+		[1] = "DHAKA_DSJM_BOE_02",
+		[2] = "AE067TT3",
+		[3] = "AE188DS0",
+	};
+	struct device *dev = tcm_hcd->pdev->dev.parent;
+	unsigned int variant = g_firmware_version_v2;
+
+	if (variant >= ARRAY_SIZE(prefix))
+		variant = 0;
+
+	dev_info(dev, "TD4160B firmware: %s%c%c\n", prefix[variant],
+		 tcm_hcd->app_info.customer_config_id[14],
+		 tcm_hcd->app_info.customer_config_id[15]);
+}
