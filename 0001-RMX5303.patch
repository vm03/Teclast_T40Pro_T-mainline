+		{
+			retval = testing_do_test_item_v2(TEST_PT7_DYNAMIC_RANGE, TEST_LIMIT_ROW_CNT, TEST_LIMIT_COL_CNT, pt7_low_limits_new,
+				pt7_hi_limits_new_latte_t, g_testing_output_buf_v2, OUTPUT_TO_CSV_STRING_LEN_v2);
+			if (retval < 0) {
+				error_count_v2++;
+			}
+		} else if (g_firmware_version_v2 == 3)
+		{
+			retval = testing_do_test_item_v2(TEST_PT7_DYNAMIC_RANGE, TEST_LIMIT_ROW_CNT, TEST_LIMIT_COL_CNT, pt7_low_limits_new,
+				pt7_hi_limits_new_nairobi, g_testing_output_buf_v2, OUTPUT_TO_CSV_STRING_LEN_v2);
+			if (retval < 0) {
+				error_count_v2++;
+			}
+		}
+
+		retval = testing_do_test_item_v2(TEST_PT10_DELTA_NOISE, TEST_LIMIT_ROW_CNT, TEST_LIMIT_COL_CNT, NULL,
+			pt10_high_limits_new, g_testing_output_buf_v2, OUTPUT_TO_CSV_STRING_LEN_v2);
+		if (retval < 0) {
+			error_count_v2++;
+		}
