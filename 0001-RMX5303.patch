+	LOGE(tcm_hcd->pdev->dev.parent,
+			"Failed to enable wakeup gesture mode\n");
+		return retval;
+	}
+
+#endif
+#ifndef OMNIVISION_FOR_GKI
+	retval = testing_do_black_testing();
+	printk("testing_do_black_testing: %d\n", retval);
+	if (retval < 0) {
+		LOGE(tcm_hcd->pdev->dev.parent,
+				"black screen test failed.\n");
+	}
+#else
+
+	if(g_firmware_version_v2 == 1 || g_firmware_version_v2 == 2 || g_firmware_version_v2 == 3){
+		if (!g_testing_output_buf_v2) {
+			g_testing_output_buf_v2 = kmalloc(OUTPUT_TO_CSV_STRING_LEN_v2, GFP_KERNEL);
