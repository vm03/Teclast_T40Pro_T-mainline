+#ifdef SUPPORT_VERIFICATION_REPORT_INFO
+static unsigned int verificationCrc32(unsigned char *data, unsigned short len)
+{
+    unsigned int crc = 0xa55a;
+    unsigned char i = 0;
+    while(len--)
+    {
+        crc ^= (unsigned int)(*data++) << 24;
+
+        for(i = 0; i < 8; ++i)
+        {
+            if(crc & 0x80000000)
+                crc = (crc << 1) ^ 0x04C11234L;
+            else
+                crc <<= 1;
+        }
+    }
+    return crc;
+}
+#endif
