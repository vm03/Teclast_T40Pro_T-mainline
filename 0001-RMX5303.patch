+static int td4160b_panel_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct td4160b_panel *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct td4160b_panel, panel,
+				   &td4160b_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->dsi = dsi;
+
+	dev_info(dev, "probe: TD4160B panel driver entered\n");
+
+	/* Optional regulator corresponding to downstream regulator_get(..., "power"). */
+	ctx->supply = devm_regulator_get_optional(dev, "power");
+	if (IS_ERR(ctx->supply)) {
+		ret = PTR_ERR(ctx->supply);
+		if (ret == -ENODEV)
+			ctx->supply = NULL;
+		else
+			return dev_err_probe(dev, ret, "failed to get panel power supply\n");
+	}
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "probe: failed to get reset GPIO\n");
+
+	/* Use standard descriptor GPIO properties: avdd-gpios and avee-gpios. */
+	ctx->avdd_gpio = devm_gpiod_get(dev, "avdd", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->avdd_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->avdd_gpio),
+				     "probe: failed to get avdd-gpios\n");
+
+	ctx->avee_gpio = devm_gpiod_get(dev, "avee", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->avee_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->avee_gpio),
+				     "probe: failed to get avee-gpios\n");
+
+	dev_info(dev, "probe: reset, AVDD and AVEE GPIOs acquired\n");
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST;
+	dsi->hs_rate = 1110000000ULL;
+	dsi->lp_rate = 20000000ULL;
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->panel.prepare_prev_first = true;
+
+	/* The DTS has an inline oled-backlight node, not a standard backlight phandle. */
+	{
+		struct backlight_properties props = {
+			.type = BACKLIGHT_RAW,
+			.max_brightness = 4095,
+			.brightness = 1306,
+		};
+
+		ctx->backlight = devm_backlight_device_register(dev,
+				"td4160b-oled", dev, ctx,
+				&td4160b_backlight_ops, &props);
+		if (IS_ERR(ctx->backlight))
+			return dev_err_probe(dev, PTR_ERR(ctx->backlight),
+					     "failed to register OLED backlight\n");
+		ctx->panel.backlight = ctx->backlight;
+	}
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "probe: failed to attach DSI\n");
+	}
+
+	dev_info(dev, "probe: panel registered and attached to DSI\n");
+	return 0;
+}
+
+static void td4160b_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct td4160b_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
