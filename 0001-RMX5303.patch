+static int init_touchpanel_proc(struct test_proc_operations *ops)
+{
+	int ret = 0;
+	struct ovt_tcm_hcd *tcm_hcd = testing_hcd->tcm_hcd;
+    struct proc_dir_entry *prEntry_touchpanel = NULL;
+	struct proc_dir_entry *prEntry_tmp = NULL;
+
+	prEntry_touchpanel = proc_mkdir("touchpanel", NULL);
+    if (prEntry_touchpanel == NULL) {
+        ret = -ENOMEM;
+		LOGI(tcm_hcd->pdev->dev.parent,
+				"Couldn't create touchpanel proc entry\n");
+    }
+
+	// show baseline test interface
+    prEntry_tmp = proc_create_data("baseline_test", 0666, prEntry_touchpanel, &tp_baseline_test_proc_fops, ops);
+    if (prEntry_tmp == NULL) {
+        ret = -ENOMEM;
+		LOGI(tcm_hcd->pdev->dev.parent,
+				"Couldn't create baseline_test proc entry\n");
+    }
+
+	// show black screen test interface
+    prEntry_tmp = proc_create_data("black_screen_test", 0666, prEntry_touchpanel, &tp_black_screen_test_proc_fops, ops);
+    if (prEntry_tmp == NULL) {
+        ret = -ENOMEM;
+		LOGI(tcm_hcd->pdev->dev.parent,
+				"Couldn't create black_screen_test proc entry\n");
+    }
+	// show  glove
+    prEntry_tmp = proc_create_data("glove_mode_enable", 0666, prEntry_touchpanel, &proc_fw_glove_mode_fops, ops);
+    if (prEntry_tmp == NULL) {
+        ret = -ENOMEM;
+		LOGI(tcm_hcd->pdev->dev.parent,
+				"Couldn't create glove_mode_enable proc entry\n");
+	}
+	// show tp interface
+    prEntry_tmp = proc_create_data("double_tap_enable", 0666, prEntry_touchpanel, &tp_gesture_proc_fops, ops);
+    if (prEntry_tmp == NULL) {
+        ret = -ENOMEM;
+		LOGI(tcm_hcd->pdev->dev.parent,
+				"Couldn't create double_tap_enable proc entry\n");
+    }
+	// show charge_detect interface
+    prEntry_tmp = proc_create_data("charge_detect", 0666, prEntry_touchpanel, &charge_detect_proc_fops, ops);
+    if (prEntry_tmp == NULL) {
+        ret = -ENOMEM;
+		LOGI(tcm_hcd->pdev->dev.parent,
+				"Couldn't create charge_detect proc entry\n");
+    }
+
+	// show headset_detect interface
+    prEntry_tmp = proc_create_data("headset_detect", 0666, prEntry_touchpanel, &headset_detect_proc_fops, ops);
+    if (prEntry_tmp == NULL) {
+        ret = -ENOMEM;
+		LOGI(tcm_hcd->pdev->dev.parent,
+				"Couldn't create headset_detect proc entry\n");
+    }
+
+    prEntry_tmp = proc_create_data("smart_touch", 0666, prEntry_touchpanel, &tp_diaphragm_proc_fops, ops);
+    if (prEntry_tmp == NULL) {
+        ret = -ENOMEM;
+        LOGI(tcm_hcd->pdev->dev.parent,
+                "Couldn't create smart_touch proc entry\n");
+    }
+
+    prEntry_tmp = proc_create_data("oppo_tp_direction", 0666, prEntry_touchpanel, &tp_direction_proc_fops, ops);
+    if (prEntry_tmp == NULL) {
+        ret = -ENOMEM;
+        LOGI(tcm_hcd->pdev->dev.parent,
+                "Couldn't create oppo_tp_direction proc entry\n");
+    }
+
+	if(g_firmware_version_v2 == 1 || g_firmware_version_v2 == 2 || g_firmware_version_v2 == 3){
+		prEntry_tmp = proc_create_data("test_save_csv", 0666, prEntry_touchpanel, &ovt_proccsv_fops, ops);
+		if (prEntry_tmp == NULL) {
+			ret = -ENOMEM;
+			LOGI(tcm_hcd->pdev->dev.parent,
+					"Couldn't create test_save_csv proc entry\n");
+		}
+	}
+	if (tcm_hcd->hw_if->bdata->rainstorm_mode_support == 1){
+	// show rainstorm_mode_detect interface
+    prEntry_tmp = proc_create_data("rainstorm_mode", 0666, prEntry_touchpanel, &rainstorm_mode_detect_proc_fops, ops);
+		if (prEntry_tmp == NULL) {
+			ret = -ENOMEM;
+			LOGI(tcm_hcd->pdev->dev.parent,
+					"Couldn't create rainstorm_mode_detect proc entry\n");
+		}
+	}
+	return ret;
+}
+//oppo test proc end
