+
+struct ovt_tcm_board_data {
+	bool x_flip;
+	bool y_flip;
+	bool swap_axes;
+	/* Reset line: logical 1 == reset asserted (polarity handled by gpiolib) */
+	struct gpio_desc *reset_gpiod;
+	/* Optional discrete power switch: logical 1 == powered */
+	struct gpio_desc *power_gpiod;
+	/* Optional second reset line (TPIO), logical 1 == reset asserted */
+	struct gpio_desc *tpio_reset_gpiod;
+	unsigned int power_delay_ms;
+	unsigned int reset_delay_ms;
+	unsigned int reset_active_ms;
+	unsigned int byte_delay_us;
+	unsigned int block_delay_us;
+	unsigned int ubl_max_freq;
+	unsigned int ubl_byte_delay_us;
+	struct regulator *pwr_reg;	/* "avdd" */
+	struct regulator *bus_reg;	/* "vdd"  */
+	int rainstorm_mode_support;
+	int irq;
+};
+
+#define OMNIVISION_TCM_ID_PRODUCT (1 << 0)
+#define OMNIVISION_TCM_ID_VERSION 0x0300
+#define OMNIVISION_TCM_ID_SUBVERSION 2
+
+#define PLATFORM_DRIVER_NAME "omnivision_tcm_v2"
+
+#define TOUCH_INPUT_NAME "omnivision_tcm_v2_touch"
+#define TOUCH_INPUT_PHYS_PATH "omnivision_tcm_v2/touch_input"
+
+#define WAKEUP_GESTURE 1
+
