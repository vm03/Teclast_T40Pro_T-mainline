+/*
+ * System sleep.  When the controller follows a DRM panel the panel's
+ * prepare/unprepare sequence already drives suspend/resume, otherwise fall
+ * back to plain system sleep.
+ */
+static int ovt_tcm_pm_suspend(struct device *dev)
+{
+	struct ovt_tcm_hcd *tcm_hcd = dev_get_drvdata(dev);
+
+	if (tcm_hcd->is_panel_follower)
+		return 0;
+
+	return ovt_tcm_suspend(dev);
+}
+
+static int ovt_tcm_pm_resume(struct device *dev)
+{
+	struct ovt_tcm_hcd *tcm_hcd = dev_get_drvdata(dev);
+
+	if (tcm_hcd->is_panel_follower)
+		return 0;
+
+	return ovt_tcm_resume(dev);
+}
