+static ssize_t ovt_proc_fw_glove_set_write(struct file *file, const char *buff, size_t len, loff_t *pos)
+{
+	int retval = 0;
+	char buf[80] = {0};
+	struct ovt_tcm_hcd *tcm_hcd = testing_hcd->tcm_hcd;
+
+
+	if (copy_from_user(buf, buff, len)) {
+		return -EFAULT;
+	}
+
+	mutex_lock(&tcm_hcd->extif_mutex);
+	if (buf[0] == '0') {
+		tcm_hcd->tp_glove_flag = 0;
+		retval = ovt_tcm_set_dynamic_config_host_interface(DC_ENABLE_GLOVE, tcm_hcd->tp_glove_flag);
+		printk("omnivision tp glove_mode write 0 to close glove_mode.\n");
+	}
+	else if (buf[0] == '1') {
+		tcm_hcd->tp_glove_flag = 1;
+		retval = ovt_tcm_set_dynamic_config_host_interface(DC_ENABLE_GLOVE, tcm_hcd->tp_glove_flag);
+		printk("omnivision tp glove_mode write 1 to open glove_mode.\n");
+	}
+	if (retval < 0) {
+		LOGE(tcm_hcd->pdev->dev.parent,
+				"omnivision Failed to set dynamic config glove_mode\n");
+		goto exit;
+	}
+
+	retval = len;
+
+exit:
+	mutex_unlock(&tcm_hcd->extif_mutex);
+
+	return retval;
+}
