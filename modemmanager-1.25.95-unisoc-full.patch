diff -ruN a/src/plugins/unisoc/77-mm-unisoc-soc.rules b/src/plugins/unisoc/77-mm-unisoc-soc.rules
--- a/src/plugins/unisoc/77-mm-unisoc-soc.rules	1970-01-01 00:00:00.000000000 +0000
+++ b/src/plugins/unisoc/77-mm-unisoc-soc.rules	2026-10-17 16:34:01.156111958 +0000
@@ -0,0 +1,60 @@
+# do not edit this file, it will be overwritten on update
+
+ACTION!="add|change|move|bind", GOTO="mm_unisoc_soc_end"
+
+# Unisoc/Spreadtrum SoC modems (sprd-modem + rpmsg-wwan-net drivers).
+# Each SIM slot is a separate modem with one AT port and several net
+# interfaces; net interface N of a slot carries PDP context (cid) N, which
+# the bearer finds through ID_MM_UNISOC_NET_CID.
+# Equivalent of the oFono 81-ofono-sprd.rules (OFONO_SPRD_SLOT / OFONO_LABEL).
+
+# Stage 1: identify slot and role of each port
+
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at0", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at0", ENV{ID_MM_PORT_TYPE_AT_PRIMARY}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte0", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte0", ENV{ID_MM_UNISOC_NET_CID}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte1", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte1", ENV{ID_MM_UNISOC_NET_CID}="2"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte2", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte2", ENV{ID_MM_UNISOC_NET_CID}="3"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte3", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte3", ENV{ID_MM_UNISOC_NET_CID}="4"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte4", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte4", ENV{ID_MM_UNISOC_NET_CID}="5"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte5", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte5", ENV{ID_MM_UNISOC_NET_CID}="6"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte6", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte6", ENV{ID_MM_UNISOC_NET_CID}="7"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte7", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte7", ENV{ID_MM_UNISOC_NET_CID}="8"
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at3", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at3", ENV{ID_MM_PORT_TYPE_AT_PRIMARY}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte8", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte8", ENV{ID_MM_UNISOC_NET_CID}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte9", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte9", ENV{ID_MM_UNISOC_NET_CID}="2"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte10", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte10", ENV{ID_MM_UNISOC_NET_CID}="3"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte11", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte11", ENV{ID_MM_UNISOC_NET_CID}="4"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte12", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte12", ENV{ID_MM_UNISOC_NET_CID}="5"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte13", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte13", ENV{ID_MM_UNISOC_NET_CID}="6"
+
+# Stage 2: any other port of these drivers must not be grabbed by other
+# plugins (e.g. generic) and turned into extra modems
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", ENV{ID_MM_UNISOC_SLOT}!="0", ENV{ID_MM_UNISOC_SLOT}!="1", ENV{ID_MM_PORT_IGNORE}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ENV{ID_MM_UNISOC_SLOT}!="0", ENV{ID_MM_UNISOC_SLOT}!="1", ENV{ID_MM_PORT_IGNORE}="1"
+
+ENV{ID_MM_UNISOC_SLOT}!="0", ENV{ID_MM_UNISOC_SLOT}!="1", GOTO="mm_unisoc_soc_end"
+
+# One modem object per SIM slot
+ENV{ID_MM_UNISOC_SLOT}=="0", ENV{ID_MM_PHYSDEV_UID}="unisoc-soc-0"
+ENV{ID_MM_UNISOC_SLOT}=="1", ENV{ID_MM_PHYSDEV_UID}="unisoc-soc-1"
+
+ENV{ID_MM_UNISOC_SOC}="1"
+ENV{ID_MM_CANDIDATE}="1"
+
+LABEL="mm_unisoc_soc_end"
diff -ruN a/src/plugins/unisoc/mm-broadband-bearer-unisoc.c b/src/plugins/unisoc/mm-broadband-bearer-unisoc.c
--- a/src/plugins/unisoc/mm-broadband-bearer-unisoc.c	1970-01-01 00:00:00.000000000 +0000
+++ b/src/plugins/unisoc/mm-broadband-bearer-unisoc.c	2026-10-17 16:34:01.154742087 +0000
@@ -0,0 +1,664 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Bearer for Unisoc/Spreadtrum modems. Ported from the oFono "sprdmodem"
+ * gprs-context driver. Connection sequence:
+ *
+ *   AT+CGDCONT=<cid>,<type>,<apn>          (done by MMBroadbandBearer)
+ *   AT+CGPCO=0,"<user>","<pass>",<cid>,<auth>
+ *   AT+CGACT=1,<cid>
+ *   AT+CGCONTRDP=<cid>                     (static IP configuration)
+ *   AT+CGDATA="M-IP",<cid>
+ *
+ * Disconnection is AT+CGACT=0,<cid>.
+ */
+
+#include <config.h>
+
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+#include <ModemManager.h>
+#include "mm-base-modem-at.h"
+#include "mm-broadband-bearer-unisoc.h"
+#include "mm-kernel-device.h"
+#include "mm-log-object.h"
+#include "mm-modem-helpers.h"
+#include "mm-bind.h"
+
+G_DEFINE_TYPE (MMBroadbandBearerUnisoc, mm_broadband_bearer_unisoc, MM_TYPE_BROADBAND_BEARER)
+
+#define UNISOC_NET_CID_PROPERTY "ID_MM_UNISOC_NET_CID"
+#define UNISOC_ZERO_V6_PREFIX   "0000:0000:0000:0000"
+
+/*****************************************************************************/
+/* Net port selection: the udev rules label each net interface with the CID
+ * of the PDP context it carries (ID_MM_UNISOC_NET_CID). */
+
+static MMPort *
+find_net_port (MMBaseModem *modem,
+               guint        cid)
+{
+    GList  *l;
+    MMPort *fallback = NULL;
+    guint   n_net = 0;
+
+    for (l = mm_base_modem_peek_data_ports (modem); l; l = g_list_next (l)) {
+        MMPort         *port = MM_PORT (l->data);
+        MMKernelDevice *kernel_device;
+
+        if (mm_port_get_port_type (port) != MM_PORT_TYPE_NET)
+            continue;
+
+        n_net++;
+        if (!fallback)
+            fallback = port;
+
+        kernel_device = mm_port_peek_kernel_device (port);
+        if (kernel_device &&
+            mm_kernel_device_has_property (kernel_device, UNISOC_NET_CID_PROPERTY) &&
+            mm_kernel_device_get_property_as_int (kernel_device, UNISOC_NET_CID_PROPERTY) == (gint) cid)
+            return port;
+    }
+
+    /* Without explicit CID labelling, only accept an unambiguous setup */
+    return (n_net == 1) ? fallback : NULL;
+}
+
+/*****************************************************************************/
+/* Dial 3GPP: CGPCO + CGACT */
+
+typedef struct {
+    MMBaseModem    *modem;
+    MMPortSerialAt *primary;
+    MMPort         *data;
+    guint           cid;
+} Dial3gppContext;
+
+static void
+dial_3gpp_context_free (Dial3gppContext *ctx)
+{
+    g_clear_object (&ctx->data);
+    g_object_unref (ctx->primary);
+    g_object_unref (ctx->modem);
+    g_slice_free (Dial3gppContext, ctx);
+}
+
+static MMPort *
+dial_3gpp_finish (MMBroadbandBearer  *self,
+                  GAsyncResult       *res,
+                  GError            **error)
+{
+    return MM_PORT (g_task_propagate_pointer (G_TASK (res), error));
+}
+
+static void
+cgact_enable_ready (MMBaseModem  *modem,
+                    GAsyncResult *res,
+                    GTask        *task)
+{
+    Dial3gppContext *ctx;
+    GError          *error = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_pointer (task, g_object_ref (ctx->data), g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+cgact_enable (GTask *task)
+{
+    Dial3gppContext *ctx;
+    g_autofree gchar *command = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    command = g_strdup_printf ("+CGACT=1,%u", ctx->cid);
+    mm_base_modem_at_command_full (ctx->modem,
+                                   MM_IFACE_PORT_AT (ctx->primary),
+                                   command,
+                                   MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT,
+                                   FALSE,
+                                   FALSE,
+                                   g_task_get_cancellable (task),
+                                   (GAsyncReadyCallback) cgact_enable_ready,
+                                   task);
+}
+
+static void
+cgpco_ready (MMBaseModem  *modem,
+             GAsyncResult *res,
+             GTask        *task)
+{
+    /* Errors in the (optional) authentication setup are not fatal, just like
+     * in the oFono driver: the CGACT result decides whether we're connected. */
+    mm_base_modem_at_command_full_finish (modem, res, NULL);
+
+    if (g_task_return_error_if_cancelled (task)) {
+        g_object_unref (task);
+        return;
+    }
+
+    cgact_enable (task);
+}
+
+static guint
+build_auth_method (MMBearerProperties *config)
+{
+    MMBearerAllowedAuth allowed;
+
+    allowed = mm_bearer_properties_get_allowed_auth (config);
+    if (allowed & MM_BEARER_ALLOWED_AUTH_CHAP)
+        return 2;
+    if (allowed & MM_BEARER_ALLOWED_AUTH_PAP)
+        return 1;
+    if (mm_bearer_properties_get_user (config))
+        return 1;
+    return 0;
+}
+
+static void
+dial_3gpp (MMBroadbandBearer   *_self,
+           MMBaseModem         *modem,
+           MMPortSerialAt      *primary,
+           guint                cid,
+           GCancellable        *cancellable,
+           GAsyncReadyCallback  callback,
+           gpointer             user_data)
+{
+    MMBroadbandBearerUnisoc *self = MM_BROADBAND_BEARER_UNISOC (_self);
+    MMBearerProperties      *config;
+    Dial3gppContext         *ctx;
+    GTask                   *task;
+    const gchar             *user;
+    const gchar             *password;
+    g_autofree gchar        *command = NULL;
+
+    g_assert (primary != NULL);
+
+    task = g_task_new (self, cancellable, callback, user_data);
+
+    ctx = g_slice_new0 (Dial3gppContext);
+    ctx->modem   = g_object_ref (modem);
+    ctx->primary = g_object_ref (primary);
+    ctx->cid     = cid;
+    g_task_set_task_data (task, ctx, (GDestroyNotify) dial_3gpp_context_free);
+
+    ctx->data = find_net_port (modem, cid);
+    if (!ctx->data) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_NOT_FOUND,
+                                 "No net port found for PDP context %u", cid);
+        g_object_unref (task);
+        return;
+    }
+    g_object_ref (ctx->data);
+
+    config   = mm_base_bearer_peek_config (MM_BASE_BEARER (self));
+    user     = config ? mm_bearer_properties_get_user (config) : NULL;
+    password = config ? mm_bearer_properties_get_password (config) : NULL;
+
+    if ((user && strchr (user, '"')) || (password && strchr (password, '"'))) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                                 "Invalid characters in user or password");
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "dialing PDP context %u on net port '%s'",
+                cid, mm_port_get_device (ctx->data));
+
+    command = g_strdup_printf ("+CGPCO=0,\"%s\",\"%s\",%u,%u",
+                               user ? user : "",
+                               password ? password : "",
+                               cid,
+                               config ? build_auth_method (config) : 0);
+    mm_base_modem_at_command_full (modem,
+                                   MM_IFACE_PORT_AT (primary),
+                                   command,
+                                   10,
+                                   FALSE,
+                                   FALSE,
+                                   cancellable,
+                                   (GAsyncReadyCallback) cgpco_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+/* IP config: CGCONTRDP + CGDATA="M-IP" */
+
+typedef struct {
+    MMBaseModem      *modem;
+    MMPortSerialAt   *primary;
+    guint             cid;
+    MMBearerIpFamily  ip_family;
+    MMBearerIpConfig *ipv4_config;
+    MMBearerIpConfig *ipv6_config;
+} IpConfigContext;
+
+static void
+ip_config_context_free (IpConfigContext *ctx)
+{
+    g_clear_object (&ctx->ipv4_config);
+    g_clear_object (&ctx->ipv6_config);
+    g_object_unref (ctx->primary);
+    g_object_unref (ctx->modem);
+    g_slice_free (IpConfigContext, ctx);
+}
+
+static gboolean
+get_ip_config_3gpp_finish (MMBroadbandBearer   *self,
+                           GAsyncResult        *res,
+                           MMBearerIpConfig   **ipv4_config,
+                           MMBearerIpConfig   **ipv6_config,
+                           GError             **error)
+{
+    IpConfigContext *ctx;
+
+    if (!g_task_propagate_boolean (G_TASK (res), error))
+        return FALSE;
+
+    ctx = g_task_get_task_data (G_TASK (res));
+    if (ipv4_config)
+        *ipv4_config = ctx->ipv4_config ? g_object_ref (ctx->ipv4_config) : NULL;
+    if (ipv6_config)
+        *ipv6_config = ctx->ipv6_config ? g_object_ref (ctx->ipv6_config) : NULL;
+    return TRUE;
+}
+
+static gchar *
+clean_field (const gchar *field)
+{
+    gchar *str;
+
+    str = g_strdup (field);
+    g_strstrip (str);
+    g_strdelimit (str, "\"", ' ');
+    g_strstrip (str);
+    return str;
+}
+
+static gboolean
+is_empty_address (const gchar *str)
+{
+    return !str || !str[0] || g_str_equal (str, "0.0.0.0") || g_str_equal (str, "::");
+}
+
+/* "a.b.c.d.m.m.m.m" -> address + prefix length */
+static gboolean
+parse_ipv4_address_and_mask (const gchar  *str,
+                             gchar       **out_address,
+                             guint        *out_prefix)
+{
+    g_auto(GStrv) parts = NULL;
+    guint         i, prefix = 0;
+    gboolean      seen_zero = FALSE;
+
+    parts = g_strsplit (str, ".", -1);
+    if (g_strv_length (parts) != 8)
+        return FALSE;
+
+    for (i = 0; i < 8; i++) {
+        gchar *endp = NULL;
+        gulong val = strtoul (parts[i], &endp, 10);
+
+        if (!parts[i][0] || *endp != '\0' || val > 255)
+            return FALSE;
+
+        if (i >= 4) {
+            guint bit;
+
+            for (bit = 0; bit < 8; bit++) {
+                if (val & (0x80 >> bit)) {
+                    if (seen_zero)
+                        return FALSE; /* non-contiguous mask */
+                    prefix++;
+                } else
+                    seen_zero = TRUE;
+            }
+        }
+    }
+
+    *out_address = g_strdup_printf ("%s.%s.%s.%s", parts[0], parts[1], parts[2], parts[3]);
+    *out_prefix = prefix;
+    return TRUE;
+}
+
+/* "<ipv6 address> <netmask>"; a zero prefix means only link-local is known */
+static gboolean
+parse_ipv6_address (const gchar  *str,
+                    gchar       **out_address,
+                    gboolean     *out_link_local)
+{
+    const gchar *space;
+    gchar       *address;
+
+    space = strchr (str, ' ');
+    if (!space || space == str)
+        return FALSE;
+
+    address = g_strndup (str, space - str);
+    if (!strchr (address, ':')) {
+        g_free (address);
+        return FALSE;
+    }
+
+    *out_link_local = FALSE;
+    if (g_str_has_prefix (address, UNISOC_ZERO_V6_PREFIX)) {
+        memcpy (address, "fe80", 4);
+        *out_link_local = TRUE;
+    }
+
+    *out_address = address;
+    return TRUE;
+}
+
+static void
+build_dns_array (const gchar  *dns1,
+                 const gchar  *dns2,
+                 const gchar **out)
+{
+    guint n = 0;
+
+    if (!is_empty_address (dns1))
+        out[n++] = dns1;
+    if (!is_empty_address (dns2))
+        out[n++] = dns2;
+    out[n] = NULL;
+}
+
+static gboolean
+parse_cgcontrdp (IpConfigContext  *ctx,
+                 const gchar      *response,
+                 GError          **error)
+{
+    g_auto(GStrv) lines = NULL;
+    guint         i;
+
+    lines = g_strsplit_set (response, "\r\n", -1);
+    for (i = 0; lines[i]; i++) {
+        g_auto(GStrv)     fields = NULL;
+        g_autofree gchar *cid_str = NULL;
+        g_autofree gchar *ip_mask = NULL;
+        g_autofree gchar *gw = NULL;
+        g_autofree gchar *dns1 = NULL;
+        g_autofree gchar *dns2 = NULL;
+        const gchar      *line;
+        const gchar      *dns[3];
+        gchar            *address = NULL;
+        guint             prefix = 0;
+        gboolean          link_local = FALSE;
+
+        line = lines[i];
+        while (*line == ' ')
+            line++;
+        if (!g_str_has_prefix (line, "+CGCONTRDP:"))
+            continue;
+        line += strlen ("+CGCONTRDP:");
+
+        /* <cid>,<bearer_id>,<apn>,<ip addr + mask>,<gw>,<dns1>,<dns2>[,...] */
+        fields = g_strsplit (line, ",", -1);
+        if (g_strv_length (fields) < 7)
+            continue;
+
+        cid_str = clean_field (fields[0]);
+        if ((guint) atoi (cid_str) != ctx->cid)
+            continue;
+
+        ip_mask = clean_field (fields[3]);
+        gw      = clean_field (fields[4]);
+        dns1    = clean_field (fields[5]);
+        dns2    = clean_field (fields[6]);
+        build_dns_array (dns1, dns2, dns);
+
+        if (parse_ipv4_address_and_mask (ip_mask, &address, &prefix)) {
+            g_clear_object (&ctx->ipv4_config);
+            ctx->ipv4_config = mm_bearer_ip_config_new ();
+            mm_bearer_ip_config_set_method  (ctx->ipv4_config, MM_BEARER_IP_METHOD_STATIC);
+            mm_bearer_ip_config_set_address (ctx->ipv4_config, address);
+            mm_bearer_ip_config_set_prefix  (ctx->ipv4_config, prefix);
+            if (!is_empty_address (gw))
+                mm_bearer_ip_config_set_gateway (ctx->ipv4_config, gw);
+            if (dns[0])
+                mm_bearer_ip_config_set_dns (ctx->ipv4_config, dns);
+            g_free (address);
+        } else if (parse_ipv6_address (ip_mask, &address, &link_local)) {
+            g_clear_object (&ctx->ipv6_config);
+            ctx->ipv6_config = mm_bearer_ip_config_new ();
+            if (link_local) {
+                /* Only a link-local address is known: let the host do SLAAC */
+                mm_bearer_ip_config_set_method (ctx->ipv6_config, MM_BEARER_IP_METHOD_DHCP);
+            } else {
+                mm_bearer_ip_config_set_method  (ctx->ipv6_config, MM_BEARER_IP_METHOD_STATIC);
+                mm_bearer_ip_config_set_address (ctx->ipv6_config, address);
+                mm_bearer_ip_config_set_prefix  (ctx->ipv6_config, 64);
+                if (!is_empty_address (gw))
+                    mm_bearer_ip_config_set_gateway (ctx->ipv6_config, gw);
+                if (dns[0])
+                    mm_bearer_ip_config_set_dns (ctx->ipv6_config, dns);
+            }
+            g_free (address);
+        }
+    }
+
+    if (!ctx->ipv4_config && !ctx->ipv6_config) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "No IP configuration reported for context %u", ctx->cid);
+        return FALSE;
+    }
+
+    return TRUE;
+}
+
+static void
+cgdata_ready (MMBaseModem  *modem,
+              GAsyncResult *res,
+              GTask        *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+cgcontrdp_ready (MMBaseModem  *modem,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    IpConfigContext  *ctx;
+    const gchar      *response;
+    GError           *error = NULL;
+    g_autofree gchar *command = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (!response || !parse_cgcontrdp (ctx, response, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    /* Switch the context into raw IP data mode on the net interface */
+    command = g_strdup_printf ("+CGDATA=\"M-IP\",%u", ctx->cid);
+    mm_base_modem_at_command_full (ctx->modem,
+                                   MM_IFACE_PORT_AT (ctx->primary),
+                                   command,
+                                   MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT,
+                                   FALSE,
+                                   FALSE,
+                                   g_task_get_cancellable (task),
+                                   (GAsyncReadyCallback) cgdata_ready,
+                                   task);
+}
+
+static void
+get_ip_config_3gpp (MMBroadbandBearer   *self,
+                    MMBroadbandModem    *modem,
+                    MMPortSerialAt      *primary,
+                    MMPortSerialAt      *secondary,
+                    MMPort              *data,
+                    guint                cid,
+                    MMBearerIpFamily     ip_family,
+                    GAsyncReadyCallback  callback,
+                    gpointer             user_data)
+{
+    IpConfigContext  *ctx;
+    GTask            *task;
+    g_autofree gchar *command = NULL;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    ctx = g_slice_new0 (IpConfigContext);
+    ctx->modem     = g_object_ref (MM_BASE_MODEM (modem));
+    ctx->primary   = g_object_ref (primary);
+    ctx->cid       = cid;
+    ctx->ip_family = ip_family;
+    g_task_set_task_data (task, ctx, (GDestroyNotify) ip_config_context_free);
+
+    command = g_strdup_printf ("+CGCONTRDP=%u", cid);
+    mm_base_modem_at_command_full (ctx->modem,
+                                   MM_IFACE_PORT_AT (primary),
+                                   command,
+                                   10,
+                                   FALSE,
+                                   FALSE,
+                                   NULL,
+                                   (GAsyncReadyCallback) cgcontrdp_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+/* Disconnect 3GPP: CGACT=0 */
+
+static gboolean
+disconnect_3gpp_finish (MMBroadbandBearer  *self,
+                        GAsyncResult       *res,
+                        GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+cgact_disable_ready (MMBaseModem  *modem,
+                     GAsyncResult *res,
+                     GTask        *task)
+{
+    /* The oFono driver treats the context as deactivated regardless of the
+     * result; keep the same behavior so the bearer never gets stuck. */
+    mm_base_modem_at_command_full_finish (modem, res, NULL);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+disconnect_3gpp (MMBroadbandBearer   *self,
+                 MMBroadbandModem    *modem,
+                 MMPortSerialAt      *primary,
+                 MMPortSerialAt      *secondary,
+                 MMPort              *data,
+                 guint                cid,
+                 GAsyncReadyCallback  callback,
+                 gpointer             user_data)
+{
+    GTask            *task;
+    g_autofree gchar *command = NULL;
+
+    g_assert (primary != NULL);
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    command = (cid > 0) ? g_strdup_printf ("+CGACT=0,%u", cid) : g_strdup ("+CGACT=0");
+    mm_obj_dbg (self, "deactivating PDP context: %s", command);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (modem),
+                                   MM_IFACE_PORT_AT (primary),
+                                   command,
+                                   45,
+                                   FALSE,
+                                   FALSE,
+                                   NULL,
+                                   (GAsyncReadyCallback) cgact_disable_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+
+MMBaseBearer *
+mm_broadband_bearer_unisoc_new_finish (GAsyncResult  *res,
+                                       GError       **error)
+{
+    GObject *bearer;
+    GObject *source;
+
+    source = g_async_result_get_source_object (res);
+    bearer = g_async_initable_new_finish (G_ASYNC_INITABLE (source), res, error);
+    g_object_unref (source);
+
+    if (!bearer)
+        return NULL;
+
+    /* Only export valid bearers */
+    mm_base_bearer_export (MM_BASE_BEARER (bearer));
+
+    return MM_BASE_BEARER (bearer);
+}
+
+void
+mm_broadband_bearer_unisoc_new (MMBroadbandModemUnisoc *modem,
+                                MMBearerProperties     *config,
+                                GCancellable           *cancellable,
+                                GAsyncReadyCallback     callback,
+                                gpointer                user_data)
+{
+    g_async_initable_new_async (
+        MM_TYPE_BROADBAND_BEARER_UNISOC,
+        G_PRIORITY_DEFAULT,
+        cancellable,
+        callback,
+        user_data,
+        MM_BASE_BEARER_MODEM, modem,
+        MM_BIND_TO, modem,
+        MM_BASE_BEARER_CONFIG, config,
+        NULL);
+}
+
+static void
+mm_broadband_bearer_unisoc_init (MMBroadbandBearerUnisoc *self)
+{
+}
+
+static void
+mm_broadband_bearer_unisoc_class_init (MMBroadbandBearerUnisocClass *klass)
+{
+    MMBroadbandBearerClass *broadband_bearer_class = MM_BROADBAND_BEARER_CLASS (klass);
+
+    broadband_bearer_class->dial_3gpp                = dial_3gpp;
+    broadband_bearer_class->dial_3gpp_finish         = dial_3gpp_finish;
+    broadband_bearer_class->get_ip_config_3gpp       = get_ip_config_3gpp;
+    broadband_bearer_class->get_ip_config_3gpp_finish = get_ip_config_3gpp_finish;
+    broadband_bearer_class->disconnect_3gpp          = disconnect_3gpp;
+    broadband_bearer_class->disconnect_3gpp_finish   = disconnect_3gpp_finish;
+}
