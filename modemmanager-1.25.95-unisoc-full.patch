diff -ruN a/src/plugins/unisoc/mm-broadband-modem-unisoc.c b/src/plugins/unisoc/mm-broadband-modem-unisoc.c
--- a/src/plugins/unisoc/mm-broadband-modem-unisoc.c	1970-01-01 00:00:00.000000000 +0000
+++ b/src/plugins/unisoc/mm-broadband-modem-unisoc.c	2026-10-24 17:32:03.943192441 +0000
@@ -0,0 +1,1801 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Unisoc/Spreadtrum (SPRD) AT modem support. The vendor quirks implemented
+ * here come from the oFono "sprd" plugin and the atmodem/sprdmodem drivers:
+ *
+ *  - power control through AT+SFUN=4 (online) / AT+SFUN=5 (offline)
+ *  - AT+CGPIAF=1 and AT+SMMSWAP=0 after power up
+ *  - signal quality from AT+CESQ (RSRP > RSCP > RXLEV); the +CESQ/+CSQ and
+ *    other vendor URCs are swallowed so they don't pollute command responses
+ *  - PIN/PUK retry counters from AT+XX=0..3
+ *  - model reported as "SIM <slot + 1>" (the AT+CGMM answer is only the firmware tag)
+ *  - network mode selection through AT+SPTESTMODE (both SIM slots at once)
+ *  - USSD requests as plain text with the 7-bit DCS, UCS-2 hex replies
+ *  - +CPMS=? answers wrapped in an additional pair of parentheses
+ *  - +CTZV network time URCs in "yy/mm/dd,hh:mm:ss+tz,dst" format
+ *  - call state reported only via ^DSCI URCs (no RING/+CLIP, +CLCC mode 1):
+ *    the call list is built from them, and the +CDU: line in ATD answers is
+ *    ignored
+ *  - one net interface per PDP context (see the bearer)
+ */
+
+#include <config.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <glib.h>
+#include <glib-object.h>
+#include <gio/gio.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-iface-modem.h"
+#include "mm-iface-modem-messaging.h"
+#include "mm-iface-modem-time.h"
+#include "mm-iface-modem-voice.h"
+#include "mm-call-list.h"
+#include "mm-iface-modem-3gpp.h"
+#include "mm-iface-modem-3gpp-ussd.h"
+#include "mm-charsets.h"
+#include "mm-kernel-device.h"
+#include "mm-port.h"
+#include "mm-base-modem-at.h"
+#include "mm-modem-helpers.h"
+#include "mm-port-serial-at.h"
+#include "mm-broadband-bearer-unisoc.h"
+#include "mm-sim-unisoc.h"
+#include "mm-broadband-modem-unisoc.h"
+
+static guint get_sim_slot (MMBroadbandModemUnisoc *self);
+static gboolean unisoc_vendor_init_enabled (MMBroadbandModemUnisoc *self);
+static void schedule_default_mode_normalization (MMBroadbandModemUnisoc *self);
+
+static void iface_modem_init           (MMIfaceModemInterface          *iface);
+static void iface_modem_messaging_init (MMIfaceModemMessagingInterface *iface);
+static void iface_modem_voice_init     (MMIfaceModemVoiceInterface     *iface);
+static void iface_modem_3gpp_ussd_init (MMIfaceModem3gppUssdInterface  *iface);
+
+G_DEFINE_TYPE_EXTENDED (MMBroadbandModemUnisoc, mm_broadband_modem_unisoc, MM_TYPE_BROADBAND_MODEM, 0,
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM, iface_modem_init)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_MESSAGING, iface_modem_messaging_init)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_VOICE, iface_modem_voice_init)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_3GPP_USSD, iface_modem_3gpp_ussd_init))
+
+/*****************************************************************************/
+/* Per-modem state */
+
+#define UNISOC_STATE_TAG "unisoc-state"
+
+typedef struct {
+    gboolean mode_normalize_pending; /* default mode of the secondary slot to be changed once the radio is on */
+    gboolean radio_on;         /* this modem asked for the radio to be on */
+    gboolean mode_normalized;  /* default mode of the secondary slot already handled */
+    gboolean mode_urc_seen;    /* +SPTESTMODE notification received before we waited for it */
+    GTask   *mode_task;        /* network mode change waiting for the notification */
+    guint    mode_timeout_id;
+} UnisocState;
+
+/* AT+SFUN=4/5 control the radio of the whole modem, not of one SIM slot: both
+ * modem objects share it, so keep track of how many of them want it on. */
+static guint n_radio_on;
+
+static void
+unisoc_state_free (UnisocState *state)
+{
+    if (state->radio_on && n_radio_on > 0)
+        n_radio_on--;
+    if (state->mode_timeout_id)
+        g_source_remove (state->mode_timeout_id);
+    g_clear_object (&state->mode_task);
+    g_free (state);
+}
+
+static UnisocState *
+get_state (MMBroadbandModemUnisoc *self)
+{
+    UnisocState *state;
+
+    state = g_object_get_data (G_OBJECT (self), UNISOC_STATE_TAG);
+    if (!state) {
+        state = g_new0 (UnisocState, 1);
+        g_object_set_data_full (G_OBJECT (self), UNISOC_STATE_TAG, state,
+                                (GDestroyNotify) unisoc_state_free);
+    }
+    return state;
+}
+
+static void
+radio_mark_on (UnisocState *state)
+{
+    if (!state->radio_on) {
+        state->radio_on = TRUE;
+        n_radio_on++;
+    }
+}
+
+/* Returns TRUE if no other modem needs the radio any more */
+static gboolean
+radio_mark_off (UnisocState *state)
+{
+    if (state->radio_on) {
+        state->radio_on = FALSE;
+        if (n_radio_on > 0)
+            n_radio_on--;
+    }
+    return n_radio_on == 0;
+}
+
+/*****************************************************************************/
+/* Power state handling: AT+SFUN */
+
+static MMModemPowerState
+load_power_state_finish (MMIfaceModem  *self,
+                         GAsyncResult  *res,
+                         GError       **error)
+{
+    gssize value;
+
+    value = g_task_propagate_int (G_TASK (res), error);
+    return value < 0 ? MM_MODEM_POWER_STATE_UNKNOWN : (MMModemPowerState) value;
+}
+
+static void
+load_power_state (MMIfaceModem        *self,
+                  GAsyncReadyCallback  callback,
+                  gpointer             user_data)
+{
+    GTask *task;
+
+    /* AT+CFUN? is not meaningful on these modems; AT+SFUN has no query form.
+     * Report low power so that the generic code always runs the power up
+     * sequence (AT+SFUN=4) when the modem is enabled. The radio is not started
+     * before: while it is starting (that takes a few seconds) the modem may stop
+     * answering if the SIM and registration queries of the generic initialization
+     * are sent at the same time. The Android RIL keeps the command channel idle
+     * during that time. */
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_int (task, MM_MODEM_POWER_STATE_LOW);
+    g_object_unref (task);
+}
+
+static gboolean
+modem_power_change_finish (MMIfaceModem  *self,
+                           GAsyncResult  *res,
+                           GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+sfun_ready (MMBaseModem  *self,
+            GAsyncResult *res,
+            GTask        *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_finish (self, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+sfun_run (MMIfaceModem        *self,
+          const gchar         *command,
+          GAsyncReadyCallback  callback,
+          gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              command,
+                              30,
+                              FALSE,
+                              (GAsyncReadyCallback) sfun_ready,
+                              task);
+}
+
+static void
+modem_power_up (MMIfaceModem        *self,
+                GAsyncReadyCallback  callback,
+                gpointer             user_data)
+{
+    MMBroadbandModemUnisoc *unisoc = MM_BROADBAND_MODEM_UNISOC (self);
+
+    radio_mark_on (get_state (unisoc));
+
+    /* Like the Android RIL, tell the modem about the two SIM cards before
+     * starting the radio */
+    if (unisoc_vendor_init_enabled (unisoc) && get_sim_slot (unisoc) == 1)
+        mm_base_modem_at_command (MM_BASE_MODEM (self), "+SPCARDINFO=2,1,0", 3, FALSE, NULL, NULL);
+
+    sfun_run (self, "+SFUN=4", callback, user_data);
+}
+
+static void
+modem_power_off_common (MMIfaceModem        *self,
+                        GAsyncReadyCallback  callback,
+                        gpointer             user_data)
+{
+    GTask *task;
+
+    if (radio_mark_off (get_state (MM_BROADBAND_MODEM_UNISOC (self)))) {
+        sfun_run (self, "+SFUN=5", callback, user_data);
+        return;
+    }
+
+    /* AT+SFUN=5 switches the radio off for both SIM slots */
+    mm_obj_dbg (self, "not switching the radio off: still in use by the other SIM slot");
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+modem_power_down (MMIfaceModem        *self,
+                  GAsyncReadyCallback  callback,
+                  gpointer             user_data)
+{
+    modem_power_off_common (self, callback, user_data);
+}
+
+static void
+modem_power_off (MMIfaceModem        *self,
+                 GAsyncReadyCallback  callback,
+                 gpointer             user_data)
+{
+    modem_power_off_common (self, callback, user_data);
+}
+
+/*****************************************************************************/
+/* Extra initialization after power up */
+
+/* Commands sent by the Android RIL when the screen is off, which stop the
+ * vendor notifications that nobody here uses. The modem sends them all the time
+ * otherwise (e.g. +CESQ several times per second), keeping the host awake. */
+static const gchar *quiet_commands[] = {
+    "+CCED=2,8",       /* periodic +CESQ/+CSQ reports off */
+    "+SPBARINFO=0",
+    "+SPNRCHANNEL=0",
+    "+SPPSEUDOBS=0",
+    "+SPNRCFGINFO=0",
+    "+CSCON=0",
+    "+CIREP=0",
+    NULL
+};
+
+static gboolean
+unisoc_vendor_init_enabled (MMBroadbandModemUnisoc *self)
+{
+    MMPortSerialAt *primary;
+    MMKernelDevice *kernel_device;
+
+    primary = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
+    if (!primary)
+        return TRUE;
+
+    kernel_device = mm_port_peek_kernel_device (MM_PORT (primary));
+    return !(kernel_device && mm_kernel_device_get_property_as_boolean (kernel_device, "ID_MM_UNISOC_NO_VENDOR_INIT"));
+}
+
+static gboolean
+modem_after_power_up_finish (MMIfaceModem  *self,
+                             GAsyncResult  *res,
+                             GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+modem_after_power_up (MMIfaceModem        *_self,
+                      GAsyncReadyCallback  callback,
+                      gpointer             user_data)
+{
+    MMBroadbandModemUnisoc *self = MM_BROADBAND_MODEM_UNISOC (_self);
+    GTask                  *task;
+    guint                   i;
+
+    /* All of them are best-effort, like in the oFono plugin */
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+CGPIAF=1", 3, FALSE, NULL, NULL);
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+SMMSWAP=0", 3, FALSE, NULL, NULL);
+
+    if (unisoc_vendor_init_enabled (self)) {
+        /* Call status notifications, used for the voice calls (the Android RIL
+         * enables them as well) */
+        mm_base_modem_at_command (MM_BASE_MODEM (self), "^DSCI=1", 3, FALSE, NULL, NULL);
+
+        /* Network time and time zone notifications (+CTZV) */
+        mm_base_modem_at_command (MM_BASE_MODEM (self), "+CTZR=1", 3, FALSE, NULL, NULL);
+
+        for (i = 0; quiet_commands[i]; i++)
+            mm_base_modem_at_command (MM_BASE_MODEM (self), quiet_commands[i], 3, FALSE, NULL, NULL);
+
+        /* The Android RIL selects the data SIM like this each time the radio is
+         * switched on; SIM slot 0 is the primary one */
+        if (get_sim_slot (self) == 0)
+            mm_base_modem_at_command (MM_BASE_MODEM (self), "+SPSWDATA", 3, FALSE, NULL, NULL);
+    }
+
+    if (get_state (self)->mode_normalize_pending)
+        schedule_default_mode_normalization (self);
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+/* Signal quality: AT+CESQ
+ *
+ * The modem also sends "+CESQ: ..." (and +CSQ) as URCs all the time. They are
+ * swallowed by unsolicited handlers (see setup_ports()), because unhandled
+ * lines stay in the port buffer and end up glued to the response of the next
+ * command, making it fail ("Unhandled response"). The same handler also
+ * swallows the answer to AT+CESQ itself, so the values are cached by the
+ * handler and used here.
+ */
+
+#define UNISOC_CESQ_CACHE_TAG "unisoc-cesq-cache"
+
+typedef struct {
+    gboolean valid;
+    guint    rxlev, ber, rscp, ecn0, rsrq, rsrp;
+} CesqCache;
+
+static CesqCache *
+get_cesq_cache (MMBroadbandModemUnisoc *self)
+{
+    CesqCache *cache;
+
+    cache = g_object_get_data (G_OBJECT (self), UNISOC_CESQ_CACHE_TAG);
+    if (!cache) {
+        cache = g_new0 (CesqCache, 1);
+        g_object_set_data_full (G_OBJECT (self), UNISOC_CESQ_CACHE_TAG, cache, g_free);
+    }
+    return cache;
+}
+
+static void
+cesq_received (MMPortSerialAt         *port,
+               GMatchInfo             *match_info,
+               MMBroadbandModemUnisoc *self)
+{
+    g_autofree gchar *line = NULL;
+    CesqCache        *cache;
+    guint             rxlev, ber, rscp, ecn0, rsrq, rsrp;
+
+    line = g_match_info_fetch (match_info, 0);
+    if (!line)
+        return;
+
+    if (!mm_3gpp_parse_cesq_response (line, &rxlev, &ber, &rscp, &ecn0, &rsrq, &rsrp, NULL))
+        return;
+
+    cache = get_cesq_cache (self);
+    cache->rxlev = rxlev;
+    cache->ber   = ber;
+    cache->rscp  = rscp;
+    cache->ecn0  = ecn0;
+    cache->rsrq  = rsrq;
+    cache->rsrp  = rsrp;
+    cache->valid = TRUE;
+}
+
+static guint
+load_signal_quality_finish (MMIfaceModem  *self,
+                            GAsyncResult  *res,
+                            GError       **error)
+{
+    gssize value;
+
+    value = g_task_propagate_int (G_TASK (res), error);
+    return value < 0 ? 0 : (guint) value;
+}
+
+static void
+cesq_ready (MMBaseModem  *self,
+            GAsyncResult *res,
+            GTask        *task)
+{
+    const gchar *response;
+    GError      *error = NULL;
+    CesqCache   *cache;
+    guint        rxlev, ber, rscp, ecn0, rsrq, rsrp;
+    guint        quality;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (response[0] &&
+        mm_3gpp_parse_cesq_response (response, &rxlev, &ber, &rscp, &ecn0, &rsrq, &rsrp, NULL)) {
+        /* parsed directly from the response */
+    } else {
+        /* The answer was consumed by the +CESQ URC handler */
+        cache = get_cesq_cache (MM_BROADBAND_MODEM_UNISOC (self));
+        if (!cache->valid) {
+            g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                     "No +CESQ information available");
+            g_object_unref (task);
+            return;
+        }
+        rxlev = cache->rxlev;
+        rscp  = cache->rscp;
+        rsrp  = cache->rsrp;
+    }
+
+    /* Same priority and scaling as the oFono atmodem driver */
+    if (rsrp != 255)
+        quality = (rsrp * 100) / 97;
+    else if (rscp != 255)
+        quality = (rscp * 100) / 96;
+    else if (rxlev != 99)
+        quality = (rxlev * 100) / 63;
+    else {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "No signal information reported in +CESQ");
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_int (task, MIN (quality, 100));
+    g_object_unref (task);
+}
+
+static void
+load_signal_quality (MMIfaceModem        *self,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+CESQ",
+                              5,
+                              FALSE,
+                              (GAsyncReadyCallback) cesq_ready,
+                              task);
+}
+
+/*****************************************************************************/
+/* Unlock retries: AT+XX=0;+XX=1;+XX=2;+XX=3 */
+
+static MMUnlockRetries *
+load_unlock_retries_finish (MMIfaceModem  *self,
+                            GAsyncResult  *res,
+                            GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+xx_ready (MMBaseModem  *self,
+          GAsyncResult *res,
+          GTask        *task)
+{
+    static const MMModemLock locks[] = {
+        MM_MODEM_LOCK_SIM_PIN,
+        MM_MODEM_LOCK_SIM_PIN2,
+        MM_MODEM_LOCK_SIM_PUK,
+        MM_MODEM_LOCK_SIM_PUK2,
+    };
+    g_autoptr(MMUnlockRetries) retries = NULL;
+    g_auto(GStrv)              lines = NULL;
+    const gchar               *response;
+    GError                    *error = NULL;
+    guint                      i, n = 0;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    retries = mm_unlock_retries_new ();
+
+    lines = g_strsplit_set (response, "\r\n", -1);
+    for (i = 0; lines[i] && n < G_N_ELEMENTS (locks); i++) {
+        const gchar *line = lines[i];
+
+        while (*line == ' ')
+            line++;
+        if (!g_str_has_prefix (line, "+XX:"))
+            continue;
+
+        mm_unlock_retries_set (retries, locks[n], (guint) atoi (line + strlen ("+XX:")));
+        n++;
+    }
+
+    if (n != G_N_ELEMENTS (locks)) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "Couldn't parse +XX retry counters (%u of %u found)",
+                                 n, (guint) G_N_ELEMENTS (locks));
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_pointer (task, g_steal_pointer (&retries), g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+load_unlock_retries (MMIfaceModem        *self,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+XX=0;+XX=1;+XX=2;+XX=3",
+                              3,
+                              FALSE,
+                              (GAsyncReadyCallback) xx_ready,
+                              task);
+}
+
+/*****************************************************************************/
+/* Supported SMS storages: +CPMS=? comes wrapped in an extra pair of
+ * parentheses, e.g. +CPMS: (("SM"),("SM"),("SM")) */
+
+typedef struct {
+    GArray *mem1;
+    GArray *mem2;
+    GArray *mem3;
+} SupportedStoragesResult;
+
+static void
+supported_storages_result_free (SupportedStoragesResult *result)
+{
+    if (result->mem1)
+        g_array_unref (result->mem1);
+    if (result->mem2)
+        g_array_unref (result->mem2);
+    if (result->mem3)
+        g_array_unref (result->mem3);
+    g_free (result);
+}
+
+static gboolean
+messaging_load_supported_storages_finish (MMIfaceModemMessaging  *self,
+                                          GAsyncResult           *res,
+                                          GArray                **mem1,
+                                          GArray                **mem2,
+                                          GArray                **mem3,
+                                          GError                **error)
+{
+    SupportedStoragesResult *result;
+
+    result = g_task_propagate_pointer (G_TASK (res), error);
+    if (!result)
+        return FALSE;
+
+    *mem1 = g_steal_pointer (&result->mem1);
+    *mem2 = g_steal_pointer (&result->mem2);
+    *mem3 = g_steal_pointer (&result->mem3);
+    supported_storages_result_free (result);
+    return TRUE;
+}
+
+static void
+cpms_test_ready (MMBaseModem  *self,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    SupportedStoragesResult *result;
+    const gchar             *response;
+    g_autofree gchar        *stripped = NULL;
+    g_autofree gchar        *fixed = NULL;
+    gsize                    len;
+    GError                  *error = NULL;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    stripped = g_strdup (mm_strip_tag (response, "+CPMS:"));
+    g_strstrip (stripped);
+    len = strlen (stripped);
+
+    /* Remove the extra outer level, only if present */
+    if (len > 4 && stripped[0] == '(' && stripped[1] == '(' && stripped[len - 1] == ')')
+        fixed = g_strdup_printf ("+CPMS: %.*s", (int) (len - 2), stripped + 1);
+    else
+        fixed = g_strdup_printf ("+CPMS: %s", stripped);
+
+    result = g_new0 (SupportedStoragesResult, 1);
+    if (!mm_3gpp_parse_cpms_test_response (fixed, &result->mem1, &result->mem2, &result->mem3, &error)) {
+        supported_storages_result_free (result);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_pointer (task, result, (GDestroyNotify) supported_storages_result_free);
+    g_object_unref (task);
+}
+
+static void
+messaging_load_supported_storages (MMIfaceModemMessaging *self,
+                                   GAsyncReadyCallback    callback,
+                                   gpointer               user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+CPMS=?",
+                              3,
+                              TRUE,
+                              (GAsyncReadyCallback) cpms_test_ready,
+                              task);
+}
+
+/*****************************************************************************/
+/* Create SIM */
+
+static MMBaseSim *
+create_sim_finish (MMIfaceModem  *self,
+                   GAsyncResult  *res,
+                   GError       **error)
+{
+    return mm_sim_unisoc_new_finish (res, error);
+}
+
+static void
+create_sim (MMIfaceModem        *self,
+            GAsyncReadyCallback  callback,
+            gpointer             user_data)
+{
+    mm_sim_unisoc_new (MM_BASE_MODEM (self), NULL, callback, user_data);
+}
+
+/*****************************************************************************/
+/* Create bearer */
+
+static MMBaseBearer *
+create_bearer_finish (MMIfaceModem  *self,
+                      GAsyncResult  *res,
+                      GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+bearer_new_ready (GObject      *unused,
+                  GAsyncResult *res,
+                  GTask        *task)
+{
+    MMBaseBearer *bearer;
+    GError       *error = NULL;
+
+    bearer = mm_broadband_bearer_unisoc_new_finish (res, &error);
+    if (!bearer)
+        g_task_return_error (task, error);
