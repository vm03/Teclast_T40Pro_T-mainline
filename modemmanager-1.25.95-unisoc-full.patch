+}
+
+static void
+create_bearer (MMIfaceModem        *self,
+               MMBearerProperties  *properties,
+               GAsyncReadyCallback  callback,
+               gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_obj_dbg (self, "creating Unisoc bearer...");
+    mm_broadband_bearer_unisoc_new (MM_BROADBAND_MODEM_UNISOC (self),
+                                    properties,
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) bearer_new_ready,
+                                    task);
+}
+
+/*****************************************************************************/
+/* Network time URC: +CTZV: "yy/mm/dd,hh:mm:ss+tz,dst" (tz in quarter hours) */
+
+static void
+ctzv_received (MMPortSerialAt        *port,
+               GMatchInfo            *match_info,
+               MMBroadbandModemUnisoc *self)
+{
+    g_autofree gchar  *raw = NULL;
+    g_autofree gchar  *iso8601 = NULL;
+    MMNetworkTimezone *tz;
+    gint               year, mon, mday, hour, min, sec, tzq, dst;
+    gint               offset_min;
+
+    raw = g_match_info_fetch (match_info, 1);
+    if (!raw)
+        return;
+    g_strdelimit (raw, "\"", ' ');
+    g_strstrip (raw);
+
+    if (sscanf (raw, "%d/%d/%d,%d:%d:%d%d,%d",
+                &year, &mon, &mday, &hour, &min, &sec, &tzq, &dst) != 8) {
+        mm_obj_dbg (self, "couldn't parse +CTZV time '%s'", raw);
+        return;
+    }
+
+    offset_min = tzq * 15;
+
+    iso8601 = g_strdup_printf ("%04d-%02d-%02dT%02d:%02d:%02d%c%02d:%02d",
+                               2000 + year, mon, mday, hour, min, sec,
+                               offset_min < 0 ? '-' : '+',
+                               ABS (offset_min) / 60,
+                               ABS (offset_min) % 60);
+    mm_iface_modem_time_update_network_time (MM_IFACE_MODEM_TIME (self), iso8601);
+
+    tz = mm_network_timezone_new ();
+    mm_network_timezone_set_offset (tz, offset_min);
+    mm_iface_modem_time_update_network_timezone (MM_IFACE_MODEM_TIME (self), tz);
+    g_object_unref (tz);
+}
+
+/*****************************************************************************/
+/* USSD: with AT+CSCS="IRA" the modem takes the request as plain text, together
+ * with the 7-bit data coding scheme: AT+CUSD=1,"*102#",15. (Packed GSM 7-bit hex,
+ * or hex in the AT+CSCS charset, is rejected by the network.) Replies come as
+ * "+CUSD: <n>,<hex UCS-2 text>,<dcs>", and usually with n=2 (handled in the
+ * generic code as a normal reply when it carries text). */
+
+/* BEGIN-USSD-HELPERS */
+static gchar *
+unisoc_ussd_encode_text (const gchar  *command,
+                         GError      **error)
+{
+    const gchar *p;
+
+    for (p = command; *p; p++) {
+        if (*p < 0x20 || *p > 0x7E || *p == '"') {
+            g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                         "USSD command contains unsupported characters");
+            return NULL;
+        }
+    }
+    return g_strdup (command);
+}
+
+static gboolean
+unisoc_ussd_looks_like_ucs2 (const guint8 *data,
+                             gsize         len)
+{
+    gsize i;
+
+    if (len < 2 || (len % 2) != 0)
+        return FALSE;
+
+    for (i = 0; i < len; i += 2) {
+        guint unit = ((guint) data[i] << 8) | data[i + 1];
+
+        if ((unit >= 0x0020 && unit <= 0x007E) ||
+            unit == 0x000A || unit == 0x000D ||
+            (unit >= 0x00A0 && unit <= 0x052F) ||   /* Latin, Greek, Cyrillic */
+            (unit >= 0x2010 && unit <= 0x20CF))     /* punctuation, currency */
+            continue;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static gboolean
+unisoc_ussd_is_printable_ascii (const guint8 *data,
+                                gsize         len)
+{
+    gsize i;
+
+    for (i = 0; i < len; i++) {
+        if ((data[i] < 0x20 || data[i] > 0x7E) && data[i] != 0x0A && data[i] != 0x0D)
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static gchar *
+unisoc_ussd_decode_hex (const gchar  *reply,
+                        GError      **error)
+{
+    g_autoptr(GByteArray) barray = NULL;
+    guint8               *bin;
+    gsize                 bin_len = 0;
+
+    bin = mm_utils_hexstr2bin (reply, -1, &bin_len, error);
+    if (!bin) {
+        g_prefix_error (error, "Couldn't convert HEX string to binary: ");
+        return NULL;
+    }
+    barray = g_byte_array_new_take (bin, bin_len);
+
+    /* UCS-2 replies (dcs 72) come hex encoded */
+    if (unisoc_ussd_looks_like_ucs2 (barray->data, barray->len))
+        return mm_modem_charset_bytearray_to_utf8 (barray, MM_MODEM_CHARSET_UCS2, FALSE, error);
+
+    /* Replies in the default alphabet (dcs 15) come as hex of the ASCII text when
+     * the request was sent that way (as the Android RIL does) */
+    if (barray->len >= 4 && unisoc_ussd_is_printable_ascii (barray->data, barray->len))
+        return g_strndup ((const gchar *) barray->data, barray->len);
+
+    /* Otherwise it is plain text that just happens to be made of hex digits */
+    return g_strdup (reply);
+}
+/* END-USSD-HELPERS */
+
+static gchar *
+ussd_encode (MMIfaceModem3gppUssd  *self,
+             const gchar           *command,
+             guint                 *scheme,
+             GError               **error)
+{
+    gchar *text;
+
+    text = unisoc_ussd_encode_text (command, error);
+    if (!text) {
+        g_prefix_error (error, "Failed to encode USSD command: ");
+        return NULL;
+    }
+
+    *scheme = MM_MODEM_GSM_USSD_SCHEME_7BIT;
+    return text;
+}
+
+static gchar *
+ussd_decode (MMIfaceModem3gppUssd  *self,
+             const gchar           *reply,
+             GError               **error)
+{
+    return unisoc_ussd_decode_hex (reply, error);
+}
+
+/*****************************************************************************/
+/* Network mode selection: AT+SPTESTMODE=<slot0 mode>,<slot1 mode>
+ *
+ * One command configures both SIM slots at once. Values (from oFono):
+ *   6 = LTE/auto, 22 / 14 = UMTS (primary / secondary slot),
+ *   15 / 10 = GSM (primary / secondary slot).
+ * Slot 0 is the primary slot, unless the other slot is on LTE: an active LTE
+ * slot is always the primary one. Only one RAT at a time can be chosen, and
+ * 4G is the same value as "any". */
+
+typedef enum {
+    UNISOC_RAT_ANY,
+    UNISOC_RAT_GSM,
+    UNISOC_RAT_UMTS,
+    UNISOC_RAT_LTE,
+} UnisocRat;
+
+static UnisocRat
+sprd_to_rat (gint val)
+{
+    switch (val) {
+    case 6:
+        return UNISOC_RAT_LTE;
+    case 10:
+    case 15:
+        return UNISOC_RAT_GSM;
+    case 14:
+    case 22:
+        return UNISOC_RAT_UMTS;
+    default:
+        return UNISOC_RAT_ANY;
+    }
+}
+
+static gint
+rat_to_sprd (UnisocRat rat,
+             gboolean  primary)
+{
+    switch (rat) {
+    case UNISOC_RAT_UMTS:
+        return primary ? 22 : 14;
+    case UNISOC_RAT_GSM:
+        return primary ? 15 : 10;
+    case UNISOC_RAT_ANY:
+    case UNISOC_RAT_LTE:
+    default:
+        return 6;
+    }
+}
+
+static guint
+get_sim_slot (MMBroadbandModemUnisoc *self)
+{
+    MMPortSerialAt *primary;
+    MMKernelDevice *kernel_device;
+
+    primary = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
+    if (!primary)
+        return 0;
+
+    kernel_device = mm_port_peek_kernel_device (MM_PORT (primary));
+    if (kernel_device && mm_kernel_device_has_property (kernel_device, "ID_MM_UNISOC_SLOT"))
+        return (guint) MAX (mm_kernel_device_get_property_as_int (kernel_device, "ID_MM_UNISOC_SLOT"), 0);
+    return 0;
+}
+
+/* BEGIN-SPTESTMODE-PARSER */
+static gboolean
+parse_sptestmode (const gchar *response,
+                  gint        *val0,
+                  gint        *val1)
+{
+    g_auto(GStrv) lines = NULL;
+    guint         i;
+
+    /* The answer is "+SPTESTMODE: <slot0>,<slot1>[,...]". Stray "+SPTESTMODE: <n>"
+     * notification lines may be mixed in: take the first one with two values. */
+    lines = g_strsplit_set (response, "\r\n", -1);
+    for (i = 0; lines[i]; i++) {
+        const gchar *line = lines[i];
+
+        while (*line == ' ')
+            line++;
+        if (!g_str_has_prefix (line, "+SPTESTMODE:"))
+            continue;
+        if (sscanf (line + strlen ("+SPTESTMODE:"), " %d , %d", val0, val1) == 2)
+            return TRUE;
+    }
+    return FALSE;
+}
+/* END-SPTESTMODE-PARSER */
+
+/* Supported modes */
+
+static GArray *
+load_supported_modes_finish (MMIfaceModem  *self,
+                             GAsyncResult  *res,
+                             GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+load_supported_modes (MMIfaceModem        *self,
+                      GAsyncReadyCallback  callback,
+                      gpointer             user_data)
+{
+    GTask                  *task;
+    GArray                 *combinations;
+    MMModemModeCombination  mode;
+
+    combinations = g_array_sized_new (FALSE, FALSE, sizeof (MMModemModeCombination), 3);
+
+    /* Automatic, LTE preferred (value 6) */
+    mode.allowed   = (MMModemMode) (MM_MODEM_MODE_2G | MM_MODEM_MODE_3G | MM_MODEM_MODE_4G);
+    mode.preferred = MM_MODEM_MODE_4G;
+    g_array_append_val (combinations, mode);
+
+    /* 3G only */
+    mode.allowed   = MM_MODEM_MODE_3G;
+    mode.preferred = MM_MODEM_MODE_NONE;
+    g_array_append_val (combinations, mode);
+
+    /* 2G only */
+    mode.allowed   = MM_MODEM_MODE_2G;
+    mode.preferred = MM_MODEM_MODE_NONE;
+    g_array_append_val (combinations, mode);
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_pointer (task, combinations, (GDestroyNotify) g_array_unref);
+    g_object_unref (task);
+}
+
+/* Setting the mode. The change is applied asynchronously: the modem answers OK,
+ * and some time later (about a second) it sends "+SPTESTMODE: <n>" when done. */
+
+static void cops_off_ready (MMBaseModem *self, GAsyncResult *res, GTask *task);
+
+static gboolean
+unisoc_set_mode_finish (MMBroadbandModemUnisoc  *self,
+                        GAsyncResult            *res,
+                        GError                 **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+mode_change_finished (MMBroadbandModemUnisoc *self)
+{
+    UnisocState *state = get_state (self);
+    GTask       *task;
+
+    if (state->mode_timeout_id) {
+        g_source_remove (state->mode_timeout_id);
+        state->mode_timeout_id = 0;
+    }
+
+    task = g_steal_pointer (&state->mode_task);
+    if (!task)
+        return;
+
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+sptestmode_notification (MMPortSerialAt         *port,
+                         GMatchInfo             *match_info,
+                         MMBroadbandModemUnisoc *self)
+{
+    UnisocState      *state = get_state (self);
+    g_autofree gchar *value = g_match_info_fetch (match_info, 1);
+
+    mm_obj_dbg (self, "network mode change notification received: %s", value ? value : "?");
+
+    if (state->mode_task)
+        mode_change_finished (self);
+    else
+        state->mode_urc_seen = TRUE;
+}
+
+static void
+cops_on_ready (MMBaseModem  *self,
+               GAsyncResult *res,
+               GTask        *task)
+{
+    /* Best effort */
+    mm_base_modem_at_command_finish (self, res, NULL);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+cops_off_ready (MMBaseModem  *self,
+                GAsyncResult *res,
+                GTask        *task)
+{
+    /* Best effort */
+    mm_base_modem_at_command_finish (self, res, NULL);
+    mm_base_modem_at_command (self,
+                              "+COPS=0",
+                              60,
+                              FALSE,
+                              (GAsyncReadyCallback) cops_on_ready,
+                              task);
+}
+
+static gboolean
+mode_change_timeout (MMBroadbandModemUnisoc *self)
+{
+    UnisocState *state = get_state (self);
+    GTask       *task;
+
+    state->mode_timeout_id = 0;
+
+    task = g_steal_pointer (&state->mode_task);
+    if (!task)
+        return G_SOURCE_REMOVE;
+
+    /* No notification: force a new registration, so that the mode is applied */
+    mm_obj_dbg (self, "no network mode change notification received, registering again in the network...");
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+COPS=2",
+                              15,
+                              FALSE,
+                              (GAsyncReadyCallback) cops_off_ready,
+                              task);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+sptestmode_set_ready (MMBaseModem  *_self,
+                      GAsyncResult *res,
+                      GTask        *task)
+{
+    MMBroadbandModemUnisoc *self = MM_BROADBAND_MODEM_UNISOC (_self);
+    UnisocState            *state = get_state (self);
+    GError                 *error = NULL;
+
+    if (!mm_base_modem_at_command_finish (_self, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (state->mode_urc_seen) {
+        /* The notification came already */
+        state->mode_urc_seen = FALSE;
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+
+    /* Wait for the notification, but not forever */
+    g_clear_object (&state->mode_task);
+    state->mode_task = task;
+    state->mode_timeout_id = g_timeout_add_seconds_full (G_PRIORITY_DEFAULT,
+                                                         10,
+                                                         (GSourceFunc) mode_change_timeout,
+                                                         g_object_ref (self),
+                                                         g_object_unref);
+}
+
+static void
+sptestmode_query_other_ready (MMBaseModem  *_self,
+                              GAsyncResult *res,
+                              GTask        *task)
+{
+    MMBroadbandModemUnisoc *self = MM_BROADBAND_MODEM_UNISOC (_self);
+    const gchar            *response;
+    GError                 *error = NULL;
+    UnisocRat               target, other;
+    gboolean                primary;
+    guint                   slot;
+    gint                    val0, val1;
+    g_autofree gchar       *command = NULL;
+
+    target = (UnisocRat) GPOINTER_TO_UINT (g_task_get_task_data (task));
+
+    response = mm_base_modem_at_command_finish (_self, res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (!parse_sptestmode (response, &val0, &val1)) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "Couldn't parse +SPTESTMODE response: '%s'", response);
+        g_object_unref (task);
+        return;
+    }
+
+    slot    = get_sim_slot (self);
+    primary = (slot == 0);
+    other   = sprd_to_rat (slot == 0 ? val1 : val0);
+
+    /* An active LTE slot is always the primary one */
+    if (other == UNISOC_RAT_LTE)
+        primary = FALSE;
+
+    if (slot == 0) {
+        val0 = rat_to_sprd (target, primary);
+        val1 = rat_to_sprd (other, !primary);
+    } else {
+        val0 = rat_to_sprd (other, !primary);
+        val1 = rat_to_sprd (target, primary);
+    }
+
+    get_state (self)->mode_urc_seen = FALSE;
+
+    command = g_strdup_printf ("+SPTESTMODE=%d,%d", val0, val1);
+    mm_obj_dbg (self, "setting network mode: %s", command);
+    mm_base_modem_at_command (_self,
+                              command,
+                              10,
+                              FALSE,
+                              (GAsyncReadyCallback) sptestmode_set_ready,
+                              task);
+}
+
+static void
+unisoc_set_mode (MMBroadbandModemUnisoc *self,
+                 UnisocRat               target,
+                 GAsyncReadyCallback     callback,
+                 gpointer                user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, GUINT_TO_POINTER ((guint) target), NULL);
+
+    /* Both slots are configured with a single command: query the other first */
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+SPTESTMODE?",
+                              3,
+                              FALSE,
+                              (GAsyncReadyCallback) sptestmode_query_other_ready,
+                              task);
+}
+
+/* Current modes */
+
+typedef struct {
+    MMModemMode allowed;
+    MMModemMode preferred;
+} CurrentModes;
+
+static gboolean
+load_current_modes_finish (MMIfaceModem  *self,
+                           GAsyncResult  *res,
+                           MMModemMode   *allowed,
+                           MMModemMode   *preferred,
+                           GError       **error)
+{
+    g_autofree CurrentModes *modes = NULL;
+
+    modes = g_task_propagate_pointer (G_TASK (res), error);
+    if (!modes)
+        return FALSE;
+
+    *allowed   = modes->allowed;
+    *preferred = modes->preferred;
+    return TRUE;
+}
+
+static void
+return_current_modes (GTask     *task,
+                      UnisocRat  rat)
+{
+    CurrentModes *modes;
+
+    modes = g_new0 (CurrentModes, 1);
+    switch (rat) {
+    case UNISOC_RAT_GSM:
+        modes->allowed   = MM_MODEM_MODE_2G;
+        modes->preferred = MM_MODEM_MODE_NONE;
+        break;
+    case UNISOC_RAT_UMTS:
+        modes->allowed   = MM_MODEM_MODE_3G;
+        modes->preferred = MM_MODEM_MODE_NONE;
+        break;
+    case UNISOC_RAT_LTE:
+    case UNISOC_RAT_ANY:
+    default:
+        modes->allowed   = (MMModemMode) (MM_MODEM_MODE_2G | MM_MODEM_MODE_3G | MM_MODEM_MODE_4G);
+        modes->preferred = MM_MODEM_MODE_4G;
+        break;
+    }
+
+    g_task_return_pointer (task, modes, g_free);
+    g_object_unref (task);
+}
+
+static gboolean
+unisoc_keep_default_mode (MMBroadbandModemUnisoc *self)
+{
+    MMPortSerialAt *primary;
+    MMKernelDevice *kernel_device;
+
+    primary = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
+    if (!primary)
+        return FALSE;
+
+    kernel_device = mm_port_peek_kernel_device (MM_PORT (primary));
+    return kernel_device && mm_kernel_device_get_property_as_boolean (kernel_device, "ID_MM_UNISOC_KEEP_MODE");
+}
+
+static void
+default_mode_normalized (GObject      *source,
+                         GAsyncResult *res,
+                         gpointer      user_data)
+{
+    g_autoptr(GError) error = NULL;
+
+    if (!unisoc_set_mode_finish (MM_BROADBAND_MODEM_UNISOC (source), res, &error))
+        mm_obj_warn (source, "couldn't switch the secondary SIM slot to automatic mode: %s", error->message);
+    else
+        mm_obj_dbg (source, "secondary SIM slot switched to automatic mode");
+}
+
+static gboolean
+normalize_default_mode (MMBroadbandModemUnisoc *self)
+{
+    UnisocState *state = get_state (self);
+
+    if (state->mode_normalize_pending) {
+        state->mode_normalize_pending = FALSE;
+        mm_obj_info (self, "secondary SIM slot in the default 2G only mode: switching to automatic mode");
+        unisoc_set_mode (self, UNISOC_RAT_LTE, (GAsyncReadyCallback) default_mode_normalized, NULL);
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static void
+schedule_default_mode_normalization (MMBroadbandModemUnisoc *self)
+{
+    /* Not while the radio is starting, the modem may stop answering */
+    g_timeout_add_seconds_full (G_PRIORITY_DEFAULT,
+                                10,
+                                (GSourceFunc) normalize_default_mode,
+                                g_object_ref (self),
+                                g_object_unref);
+}
+
+static void
+sptestmode_query_ready (MMBaseModem  *_self,
+                        GAsyncResult *res,
+                        GTask        *task)
+{
+    MMBroadbandModemUnisoc *self = MM_BROADBAND_MODEM_UNISOC (_self);
+    UnisocState            *state = get_state (self);
+    const gchar            *response;
+    GError                 *error = NULL;
+    gint                    val0, val1, value;
+    guint                   slot;
+
+    response = mm_base_modem_at_command_finish (_self, res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (!parse_sptestmode (response, &val0, &val1)) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "Couldn't parse +SPTESTMODE response: '%s'", response);
+        g_object_unref (task);
+        return;
+    }
+
+    slot  = get_sim_slot (self);
+    value = (slot == 0) ? val0 : val1;
+
+    /* After a boot the secondary slot is left in a 2G only mode (10). With that
+     * mode and both SIMs registered the modem ends up stuck unless the mode is
+     * changed soon, so the automatic mode is used by default (set the
+     * ID_MM_UNISOC_KEEP_MODE udev property to avoid it). The change itself is
+     * done later, once the radio is on, and the automatic mode is reported
+     * already. */
+    if (slot == 1 && value == 10 && !state->mode_normalized && !unisoc_keep_default_mode (self)) {
+        state->mode_normalized = TRUE;
+        state->mode_normalize_pending = TRUE;
+        return_current_modes (task, UNISOC_RAT_LTE);
+        return;
+    }
+
+    return_current_modes (task, sprd_to_rat (value));
+}
+
+static void
+load_current_modes (MMIfaceModem        *self,
+                    GAsyncReadyCallback  callback,
+                    gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+SPTESTMODE?",
+                              3,
+                              FALSE,
+                              (GAsyncReadyCallback) sptestmode_query_ready,
+                              task);
+}
+
+/* Set current modes */
+
+static gboolean
+set_current_modes_finish (MMIfaceModem  *self,
+                          GAsyncResult  *res,
+                          GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+set_current_modes (MMIfaceModem        *self,
+                   MMModemMode          allowed,
+                   MMModemMode          preferred,
+                   GAsyncReadyCallback  callback,
+                   gpointer             user_data)
+{
+    UnisocRat target;
+
+    if (allowed & MM_MODEM_MODE_4G)
+        target = UNISOC_RAT_LTE;
+    else if (allowed & MM_MODEM_MODE_3G)
+        target = UNISOC_RAT_UMTS;
+    else
+        target = UNISOC_RAT_GSM;
+
+    unisoc_set_mode (MM_BROADBAND_MODEM_UNISOC (self), target, callback, user_data);
+}
+
+/*****************************************************************************/
+/* Model: the AT+CGMM answer is just the firmware tag ("V1.0.1-B7"), the same for
+ * both SIM slots. Report the SIM slot instead, which is what e.g. GNOME Calls
+ * shows as name of the call origin (when the SIM doesn't have an own number). */
+
+static gchar *
+load_model_finish (MMIfaceModem  *self,
+                   GAsyncResult  *res,
+                   GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+load_model (MMIfaceModem        *self,
+            GAsyncReadyCallback  callback,
+            gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_pointer (task,
+                           g_strdup_printf ("SIM %u", get_sim_slot (MM_BROADBAND_MODEM_UNISOC (self)) + 1),
+                           g_free);
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+/* Voice calls.
+ *
+ * Unisoc modems report call state exclusively through ^DSCI URCs:
+ *
+ *   ^DSCI: <id>,<dir>,<stat>,<mode>,<mpty>[,<number>,<type>[,...]]
+ *
+ * with <dir> 0=outgoing 1=incoming, and <stat> using the +CLCC numbering
+ * (0 active, 1 held, 2 dialing, 3 alerting, 4 incoming, 5 waiting, 6 ended).
+ * No RING/+CLIP/+CRING is sent for incoming (VoLTE) calls, and <mode> is 1
+ * for plain voice calls, which the generic +CLCC parser would discard as
+ * data calls. So the modem keeps its own call table fed by ^DSCI and
+ * provides it as the call list, instead of polling +CLCC.
+ *
+ * Also, ATD is answered with a "+CDU:<n>" line before the final OK, which
+ * the generic code would take as an unexpected response and fail the call.
+ */
+
+#define UNISOC_CALL_TABLE_TAG "unisoc-call-table"
+
+static void
+call_info_free (MMCallInfo *info)
+{
+    g_free (info->number);
+    g_slice_free (MMCallInfo, info);
+}
+
+static GHashTable *
+get_call_table (MMBroadbandModemUnisoc *self)
+{
+    GHashTable *table;
+
+    table = g_object_get_data (G_OBJECT (self), UNISOC_CALL_TABLE_TAG);
+    if (!table) {
+        table = g_hash_table_new_full (g_direct_hash, g_direct_equal, NULL,
+                                       (GDestroyNotify) call_info_free);
+        g_object_set_data_full (G_OBJECT (self), UNISOC_CALL_TABLE_TAG, table,
+                                (GDestroyNotify) g_hash_table_unref);
+    }
+    return table;
+}
+
+static gboolean
+load_call_list_finish (MMIfaceModemVoice  *self,
+                       GAsyncResult       *res,
+                       GList             **call_info_list,
+                       GError            **error)
+{
+    GError *inner_error = NULL;
+    GList  *list;
+
+    list = g_task_propagate_pointer (G_TASK (res), &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return FALSE;
+    }
+
+    *call_info_list = list;
+    return TRUE;
+}
+
+static void
+load_call_list (MMIfaceModemVoice   *self,
+                GAsyncReadyCallback  callback,
+                gpointer             user_data)
+{
+    GTask          *task;
+    GHashTable     *table;
+    GHashTableIter  iter;
+    gpointer        value;
+    GList          *list = NULL;
+
+    table = get_call_table (MM_BROADBAND_MODEM_UNISOC (self));
+
+    g_hash_table_iter_init (&iter, table);
+    while (g_hash_table_iter_next (&iter, NULL, &value)) {
+        const MMCallInfo *src = value;
+        MMCallInfo       *dst;
+
+        dst = g_slice_new0 (MMCallInfo);
+        dst->index     = src->index;
+        dst->direction = src->direction;
+        dst->state     = src->state;
+        dst->number    = g_strdup (src->number);
+        list = g_list_append (list, dst);
+    }
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_pointer (task, list, NULL);
+    g_object_unref (task);
+}
+
+static void
+dsci_received (MMPortSerialAt         *port,
+               GMatchInfo             *match_info,
+               MMBroadbandModemUnisoc *self)
+{
+    static const MMCallState states[] = {
+        MM_CALL_STATE_ACTIVE,       /* 0 */
+        MM_CALL_STATE_HELD,         /* 1 */
+        MM_CALL_STATE_DIALING,      /* 2 */
+        MM_CALL_STATE_RINGING_OUT,  /* 3 */
+        MM_CALL_STATE_RINGING_IN,   /* 4 */
+        MM_CALL_STATE_WAITING,      /* 5 */
+        MM_CALL_STATE_TERMINATED,   /* 6 */
+    };
+    g_autofree gchar *payload = NULL;
+    g_auto(GStrv)     fields = NULL;
+    g_autoptr(MMCallList) call_list = NULL;
+    GHashTable       *table;
+    guint             idx, dir, stat;
+
+    payload = g_match_info_fetch (match_info, 1);
+    if (!payload)
+        return;
+
+    fields = g_strsplit (payload, ",", -1);
+    if (g_strv_length (fields) < 3)
+        return;
+
+    idx  = (guint) g_ascii_strtoull (g_strstrip (fields[0]), NULL, 10);
+    dir  = (guint) g_ascii_strtoull (g_strstrip (fields[1]), NULL, 10);
+    stat = (guint) g_ascii_strtoull (g_strstrip (fields[2]), NULL, 10);
+
+    if (!idx || dir > 1 || stat >= G_N_ELEMENTS (states)) {
+        mm_obj_dbg (self, "ignoring unexpected ^DSCI: %s", payload);
+        return;
+    }
+
+    table = get_call_table (self);
+
+    if (states[stat] == MM_CALL_STATE_TERMINATED) {
+        /* A call missing from the list is reported as terminated */
+        g_hash_table_remove (table, GUINT_TO_POINTER (idx));
+    } else {
+        MMCallInfo *info;
+
+        info = g_slice_new0 (MMCallInfo);
+        info->index     = idx;
+        info->direction = dir ? MM_CALL_DIRECTION_INCOMING : MM_CALL_DIRECTION_OUTGOING;
+        info->state     = states[stat];
+
+        if (g_strv_length (fields) >= 6) {
+            gchar *number;
+
+            number = g_strdup (g_strstrip (fields[5]));
+            g_strdelimit (number, "\"", ' ');
+            g_strstrip (number);
+            if (g_ascii_strncasecmp (number, "sip:", 4) == 0) {
+                gchar *stripped, *at;
+
+                stripped = g_strdup (number + 4);
+                at = strchr (stripped, '@');
+                if (at)
+                    *at = '\0';
+                g_free (number);
+                number = stripped;
+            }
+            if (number[0])
+                info->number = number;
+            else
+                g_free (number);
+        }
+
+        mm_obj_dbg (self, "call %u: direction %s, state %s%s%s",
+                    info->index,
+                    mm_call_direction_get_string (info->direction),
+                    mm_call_state_get_string (info->state),
+                    info->number ? ", number " : "",
+                    info->number ? info->number : "");
+        g_hash_table_replace (table, GUINT_TO_POINTER (idx), info);
+    }
+
+    /* Only report if the voice interface is already up and running */
+    g_object_get (self, MM_IFACE_MODEM_VOICE_CALL_LIST, &call_list, NULL);
+    if (!call_list)
+        return;
+
+    mm_iface_modem_voice_reload_all_calls (MM_IFACE_MODEM_VOICE (self), NULL, NULL);
+}
+
+static void
+setup_ports (MMBroadbandModem *self)
+{
+    g_autoptr(GRegex) ctzv_regex = NULL;
+    g_autoptr(GRegex) dsci_regex = NULL;
+    g_autoptr(GRegex) cdu_regex = NULL;
+    g_autoptr(GRegex) cesq_regex = NULL;
+    g_autoptr(GRegex) noise_regex = NULL;
+    g_autoptr(GRegex) sptestmode_urc_regex = NULL;
+    MMPortSerialAt   *ports[2];
+    guint             i;
+
+    /* Always chain up first */
+    MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_unisoc_parent_class)->setup_ports (self);
+
+    ctzv_regex = g_regex_new ("\\r\\n\\+CTZV:\\s*(.*)\\r\\n", G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (ctzv_regex);
+
+    dsci_regex = g_regex_new ("\\r\\n\\^DSCI:\\s*([^\\r\\n]*)\\r\\n", G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (dsci_regex);
+
+    /* Sent before the final OK of ATD; just swallow it */
+    cdu_regex = g_regex_new ("\\r\\n\\+CDU:[^\\r\\n]*\\r\\n", G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (cdu_regex);
+
+    /* +CESQ: only the numeric form (URC and AT+CESQ answer), not the +CESQ=? one */
+    cesq_regex = g_regex_new ("\\r\\n\\+CESQ:\\s*\\d+,\\d+,\\d+,\\d+,\\d+,\\d+[^\\r\\n]*\\r\\n", G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (cesq_regex);
+
+    /* Vendor URCs without any meaning for MM. Left unhandled they would be
+     * glued to the response of the next command. */
+    noise_regex = g_regex_new ("\\r\\n(?:\\+SP(?!TESTMODE)[A-Z0-9]+|\\+PRENWINFU|\\+IMSREGADDR|\\+CSQ|\\+SIND|\\+ECIND|"
+                               "\\+EARLYMEDIA|\\+CDUU|\\^CONN|\\^CEND|\\^ORIG):[^\\r\\n]*\\r\\n",
+                               G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (noise_regex);
+
+    /* "+SPTESTMODE: <n>" (one value) is a notification sent after a mode change,
+     * while the answer to AT+SPTESTMODE? has several comma separated values */
+    sptestmode_urc_regex = g_regex_new ("\\r\\n\\+SPTESTMODE:\\s*(\\d+)\\r\\n", G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (sptestmode_urc_regex);
+
+
+    ports[0] = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
+    ports[1] = mm_base_modem_peek_port_secondary (MM_BASE_MODEM (self));
+
+    for (i = 0; i < G_N_ELEMENTS (ports); i++) {
+        if (!ports[i])
+            continue;
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       ctzv_regex,
+                                                       (MMPortSerialAtUnsolicitedMsgFn) ctzv_received,
+                                                       self,
+                                                       NULL);
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       dsci_regex,
+                                                       (MMPortSerialAtUnsolicitedMsgFn) dsci_received,
+                                                       self,
+                                                       NULL);
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       cdu_regex,
+                                                       NULL,
+                                                       NULL,
+                                                       NULL);
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       cesq_regex,
+                                                       (MMPortSerialAtUnsolicitedMsgFn) cesq_received,
+                                                       self,
+                                                       NULL);
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       noise_regex,
+                                                       NULL,
+                                                       NULL,
+                                                       NULL);
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       sptestmode_urc_regex,
+                                                       (MMPortSerialAtUnsolicitedMsgFn) sptestmode_notification,
+                                                       self,
+                                                       NULL);
+    }
+}
+
+/*****************************************************************************/
+
+MMBroadbandModemUnisoc *
+mm_broadband_modem_unisoc_new (const gchar  *device,
+                               const gchar  *physdev,
+                               const gchar **drivers,
+                               const gchar  *plugin,
+                               guint16       vendor_id,
+                               guint16       product_id)
+{
+    return g_object_new (MM_TYPE_BROADBAND_MODEM_UNISOC,
+                         MM_BASE_MODEM_DEVICE,     device,
+                         MM_BASE_MODEM_PHYSDEV,    physdev,
+                         MM_BASE_MODEM_DRIVERS,    drivers,
+                         MM_BASE_MODEM_PLUGIN,     plugin,
+                         MM_BASE_MODEM_VENDOR_ID,  vendor_id,
+                         MM_BASE_MODEM_PRODUCT_ID, product_id,
+                         /* Control over AT, data over net interfaces */
+                         /* Only the SIM PIN and the fixed dialing locks are of use; the
+                          * Android RIL queries just those. Querying the personalization
+                          * locks while the radio starts made the modem stop answering. */
+                         MM_IFACE_MODEM_3GPP_IGNORED_FACILITY_LOCKS,
+                             (MM_MODEM_3GPP_FACILITY_PH_SIM |
+                              MM_MODEM_3GPP_FACILITY_PH_FSIM |
+                              MM_MODEM_3GPP_FACILITY_NET_PERS |
+                              MM_MODEM_3GPP_FACILITY_NET_SUB_PERS |
+                              MM_MODEM_3GPP_FACILITY_PROVIDER_PERS |
+                              MM_MODEM_3GPP_FACILITY_CORP_PERS),
+                         MM_BASE_MODEM_DATA_NET_SUPPORTED, TRUE,
+                         MM_BASE_MODEM_DATA_TTY_SUPPORTED, FALSE,
+                         /* +CIND is not used for signal reporting on these modems */
+                         MM_BROADBAND_MODEM_INDICATORS_DISABLED, TRUE,
+                         /* Incoming VoLTE calls come with an empty +CLIP: reload
+                          * the call list from +CLCC on ring instead */
+                         MM_IFACE_MODEM_VOICE_INDICATION_CALL_LIST_RELOAD_ENABLED, TRUE,
+                         NULL);
+}
+
+static void
+mm_broadband_modem_unisoc_init (MMBroadbandModemUnisoc *self)
+{
+}
+
+static void
+iface_modem_init (MMIfaceModemInterface *iface)
+{
+    iface->load_power_state               = load_power_state;
+    iface->load_power_state_finish        = load_power_state_finish;
+    iface->modem_power_up                 = modem_power_up;
+    iface->modem_power_up_finish          = modem_power_change_finish;
+    iface->modem_after_power_up           = modem_after_power_up;
+    iface->modem_after_power_up_finish    = modem_after_power_up_finish;
+    iface->modem_power_down               = modem_power_down;
+    iface->modem_power_down_finish        = modem_power_change_finish;
+    iface->modem_power_off                = modem_power_off;
+    iface->modem_power_off_finish         = modem_power_change_finish;
+    iface->load_signal_quality            = load_signal_quality;
+    iface->load_signal_quality_finish     = load_signal_quality_finish;
+    iface->load_unlock_retries            = load_unlock_retries;
+    iface->load_unlock_retries_finish     = load_unlock_retries_finish;
+    iface->create_bearer                  = create_bearer;
+    iface->create_bearer_finish           = create_bearer_finish;
+    iface->create_sim                     = create_sim;
+    iface->create_sim_finish              = create_sim_finish;
+    iface->load_model                     = load_model;
+    iface->load_model_finish              = load_model_finish;
+    iface->load_supported_modes           = load_supported_modes;
+    iface->load_supported_modes_finish    = load_supported_modes_finish;
+    iface->load_current_modes             = load_current_modes;
+    iface->load_current_modes_finish      = load_current_modes_finish;
+    iface->set_current_modes              = set_current_modes;
+    iface->set_current_modes_finish       = set_current_modes_finish;
+}
+
+static void
+iface_modem_messaging_init (MMIfaceModemMessagingInterface *iface)
+{
+    iface->load_supported_storages        = messaging_load_supported_storages;
+    iface->load_supported_storages_finish = messaging_load_supported_storages_finish;
+}
+
+static void
+iface_modem_voice_init (MMIfaceModemVoiceInterface *iface)
+{
+    iface->load_call_list        = load_call_list;
+    iface->load_call_list_finish = load_call_list_finish;
+}
+
+static void
+iface_modem_3gpp_ussd_init (MMIfaceModem3gppUssdInterface *iface)
+{
+    iface->encode = ussd_encode;
+    iface->decode = ussd_decode;
+}
+
+static void
+mm_broadband_modem_unisoc_class_init (MMBroadbandModemUnisocClass *klass)
+{
+    MMBroadbandModemClass *broadband_modem_class = MM_BROADBAND_MODEM_CLASS (klass);
+
+    broadband_modem_class->setup_ports = setup_ports;
+}
