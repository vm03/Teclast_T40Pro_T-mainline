+/*****************************************************************************/
+
+static MMBaseModem *
+create_modem (MMPlugin     *self,
+              const gchar  *uid,
+              const gchar  *physdev,
+              const gchar **drivers,
+              guint16       vendor,
+              guint16       product,
+              guint16       subsystem_vendor,
+              guint16       subsystem_device,
+              GList        *probes,
+              GError      **error)
+{
+    if (!mm_port_probe_list_has_at_port (probes)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "Unsupported device: at least an AT port is required");
+        return NULL;
+    }
+
+    mm_obj_dbg (self, "Unisoc modem found...");
+    return MM_BASE_MODEM (mm_broadband_modem_unisoc_new (uid,
+                                                         physdev,
+                                                         drivers,
+                                                         mm_plugin_get_name (self),
+                                                         vendor,
+                                                         product));
+}
+
+/*****************************************************************************/
+
+MM_PLUGIN_NAMED_CREATOR_SCOPE MMPlugin *
+mm_plugin_create_unisoc (void)
+{
+    static const gchar *subsystems[] = { "tty", "wwan", "rpmsg", "net", NULL };
+    static const gchar *udev_tags[] = {
+        "ID_MM_UNISOC_SOC",
+        NULL
+    };
+
+    return MM_PLUGIN (
+        g_object_new (MM_TYPE_PLUGIN_UNISOC,
+                      MM_PLUGIN_NAME,               MM_MODULE_NAME,
+                      MM_PLUGIN_ALLOWED_SUBSYSTEMS, subsystems,
+                      MM_PLUGIN_ALLOWED_UDEV_TAGS,  udev_tags,
+                      MM_PLUGIN_ALLOWED_AT,         TRUE,
+                      NULL));
+}
+
+static void
+mm_plugin_unisoc_init (MMPluginUnisoc *self)
+{
+}
+
+static void
+mm_plugin_unisoc_class_init (MMPluginUnisocClass *klass)
+{
+    MMPluginClass *plugin_class = MM_PLUGIN_CLASS (klass);
+
+    plugin_class->create_modem = create_modem;
+}
