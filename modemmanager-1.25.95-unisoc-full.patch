diff -ruN a/src/plugins/unisoc/mm-broadband-modem-unisoc.c b/src/plugins/unisoc/mm-broadband-modem-unisoc.c
--- a/src/plugins/unisoc/mm-broadband-modem-unisoc.c	1970-01-01 00:00:00.000000000 +0000
+++ b/src/plugins/unisoc/mm-broadband-modem-unisoc.c	2026-10-17 16:34:01.156215452 +0000
@@ -0,0 +1,907 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Unisoc/Spreadtrum (SPRD) AT modem support. The vendor quirks implemented
+ * here come from the oFono "sprd" plugin and the atmodem/sprdmodem drivers:
+ *
+ *  - power control through AT+SFUN=4 (online) / AT+SFUN=5 (offline)
+ *  - AT+CGPIAF=1 and AT+SMMSWAP=0 after power up
+ *  - signal quality from AT+CESQ (RSRP > RSCP > RXLEV); the +CESQ/+CSQ and
+ *    other vendor URCs are swallowed so they don't pollute command responses
+ *  - PIN/PUK retry counters from AT+XX=0..3
+ *  - +CPMS=? answers wrapped in an additional pair of parentheses
+ *  - +CTZV network time URCs in "yy/mm/dd,hh:mm:ss+tz,dst" format
+ *  - call state reported only via ^DSCI URCs (no RING/+CLIP, +CLCC mode 1):
+ *    the call list is built from them, and the +CDU: line in ATD answers is
+ *    ignored
+ *  - one net interface per PDP context (see the bearer)
+ */
+
+#include <config.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <glib.h>
+#include <glib-object.h>
+#include <gio/gio.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-iface-modem.h"
+#include "mm-iface-modem-messaging.h"
+#include "mm-iface-modem-time.h"
+#include "mm-iface-modem-voice.h"
+#include "mm-call-list.h"
+#include "mm-base-modem-at.h"
+#include "mm-modem-helpers.h"
+#include "mm-port-serial-at.h"
+#include "mm-broadband-bearer-unisoc.h"
+#include "mm-broadband-modem-unisoc.h"
+
+static void iface_modem_init           (MMIfaceModemInterface          *iface);
+static void iface_modem_messaging_init (MMIfaceModemMessagingInterface *iface);
+static void iface_modem_voice_init     (MMIfaceModemVoiceInterface     *iface);
+
+G_DEFINE_TYPE_EXTENDED (MMBroadbandModemUnisoc, mm_broadband_modem_unisoc, MM_TYPE_BROADBAND_MODEM, 0,
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM, iface_modem_init)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_MESSAGING, iface_modem_messaging_init)
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_VOICE, iface_modem_voice_init))
+
+/*****************************************************************************/
+/* Power state handling: AT+SFUN */
+
+static MMModemPowerState
+load_power_state_finish (MMIfaceModem  *self,
+                         GAsyncResult  *res,
+                         GError       **error)
+{
+    gssize value;
+
+    value = g_task_propagate_int (G_TASK (res), error);
+    return value < 0 ? MM_MODEM_POWER_STATE_UNKNOWN : (MMModemPowerState) value;
+}
+
+static void
+load_power_state (MMIfaceModem        *self,
+                  GAsyncReadyCallback  callback,
+                  gpointer             user_data)
+{
+    GTask *task;
+
+    /* AT+CFUN? is not meaningful on these modems; AT+SFUN has no query form.
+     * Report low power so that the generic code always runs the power up
+     * sequence (AT+SFUN=4) when the modem is enabled. */
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_int (task, MM_MODEM_POWER_STATE_LOW);
+    g_object_unref (task);
+}
+
+static gboolean
+modem_power_change_finish (MMIfaceModem  *self,
+                           GAsyncResult  *res,
+                           GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+sfun_ready (MMBaseModem  *self,
+            GAsyncResult *res,
+            GTask        *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_finish (self, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+sfun_run (MMIfaceModem        *self,
+          const gchar         *command,
+          GAsyncReadyCallback  callback,
+          gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              command,
+                              30,
+                              FALSE,
+                              (GAsyncReadyCallback) sfun_ready,
+                              task);
+}
+
+static void
+modem_power_up (MMIfaceModem        *self,
+                GAsyncReadyCallback  callback,
+                gpointer             user_data)
+{
+    sfun_run (self, "+SFUN=4", callback, user_data);
+}
+
+static void
+modem_power_down (MMIfaceModem        *self,
+                  GAsyncReadyCallback  callback,
+                  gpointer             user_data)
+{
+    sfun_run (self, "+SFUN=5", callback, user_data);
+}
+
+static void
+modem_power_off (MMIfaceModem        *self,
+                 GAsyncReadyCallback  callback,
+                 gpointer             user_data)
+{
+    sfun_run (self, "+SFUN=5", callback, user_data);
+}
+
+/*****************************************************************************/
+/* Extra initialization after power up */
+
+static gboolean
+modem_after_power_up_finish (MMIfaceModem  *self,
+                             GAsyncResult  *res,
+                             GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+modem_after_power_up (MMIfaceModem        *self,
+                      GAsyncReadyCallback  callback,
+                      gpointer             user_data)
+{
+    GTask *task;
+
+    /* Both are best-effort, like in the oFono plugin */
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+CGPIAF=1", 3, FALSE, NULL, NULL);
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+SMMSWAP=0", 3, FALSE, NULL, NULL);
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+/* Signal quality: AT+CESQ
+ *
+ * The modem also sends "+CESQ: ..." (and +CSQ) as URCs all the time. They are
+ * swallowed by unsolicited handlers (see setup_ports()), because unhandled
+ * lines stay in the port buffer and end up glued to the response of the next
+ * command, making it fail ("Unhandled response"). The same handler also
+ * swallows the answer to AT+CESQ itself, so the values are cached by the
+ * handler and used here.
+ */
+
+#define UNISOC_CESQ_CACHE_TAG "unisoc-cesq-cache"
+
+typedef struct {
+    gboolean valid;
+    guint    rxlev, ber, rscp, ecn0, rsrq, rsrp;
+} CesqCache;
+
+static CesqCache *
+get_cesq_cache (MMBroadbandModemUnisoc *self)
+{
+    CesqCache *cache;
+
+    cache = g_object_get_data (G_OBJECT (self), UNISOC_CESQ_CACHE_TAG);
+    if (!cache) {
+        cache = g_new0 (CesqCache, 1);
+        g_object_set_data_full (G_OBJECT (self), UNISOC_CESQ_CACHE_TAG, cache, g_free);
+    }
+    return cache;
+}
+
+static void
+cesq_received (MMPortSerialAt         *port,
+               GMatchInfo             *match_info,
+               MMBroadbandModemUnisoc *self)
+{
+    g_autofree gchar *line = NULL;
+    CesqCache        *cache;
+    guint             rxlev, ber, rscp, ecn0, rsrq, rsrp;
+
+    line = g_match_info_fetch (match_info, 0);
+    if (!line)
+        return;
+
+    if (!mm_3gpp_parse_cesq_response (line, &rxlev, &ber, &rscp, &ecn0, &rsrq, &rsrp, NULL))
+        return;
+
+    cache = get_cesq_cache (self);
+    cache->rxlev = rxlev;
+    cache->ber   = ber;
+    cache->rscp  = rscp;
+    cache->ecn0  = ecn0;
+    cache->rsrq  = rsrq;
+    cache->rsrp  = rsrp;
+    cache->valid = TRUE;
+}
+
+static guint
+load_signal_quality_finish (MMIfaceModem  *self,
+                            GAsyncResult  *res,
+                            GError       **error)
+{
+    gssize value;
+
+    value = g_task_propagate_int (G_TASK (res), error);
+    return value < 0 ? 0 : (guint) value;
+}
+
+static void
+cesq_ready (MMBaseModem  *self,
+            GAsyncResult *res,
+            GTask        *task)
+{
+    const gchar *response;
+    GError      *error = NULL;
+    CesqCache   *cache;
+    guint        rxlev, ber, rscp, ecn0, rsrq, rsrp;
+    guint        quality;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (response[0] &&
+        mm_3gpp_parse_cesq_response (response, &rxlev, &ber, &rscp, &ecn0, &rsrq, &rsrp, NULL)) {
+        /* parsed directly from the response */
+    } else {
+        /* The answer was consumed by the +CESQ URC handler */
+        cache = get_cesq_cache (MM_BROADBAND_MODEM_UNISOC (self));
+        if (!cache->valid) {
+            g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                     "No +CESQ information available");
+            g_object_unref (task);
+            return;
+        }
+        rxlev = cache->rxlev;
+        rscp  = cache->rscp;
+        rsrp  = cache->rsrp;
+    }
+
+    /* Same priority and scaling as the oFono atmodem driver */
+    if (rsrp != 255)
+        quality = (rsrp * 100) / 97;
+    else if (rscp != 255)
+        quality = (rscp * 100) / 96;
+    else if (rxlev != 99)
+        quality = (rxlev * 100) / 63;
+    else {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "No signal information reported in +CESQ");
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_int (task, MIN (quality, 100));
+    g_object_unref (task);
+}
+
+static void
+load_signal_quality (MMIfaceModem        *self,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+CESQ",
+                              5,
+                              FALSE,
+                              (GAsyncReadyCallback) cesq_ready,
+                              task);
+}
+
+/*****************************************************************************/
+/* Unlock retries: AT+XX=0;+XX=1;+XX=2;+XX=3 */
+
+static MMUnlockRetries *
+load_unlock_retries_finish (MMIfaceModem  *self,
+                            GAsyncResult  *res,
+                            GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+xx_ready (MMBaseModem  *self,
+          GAsyncResult *res,
+          GTask        *task)
+{
+    static const MMModemLock locks[] = {
+        MM_MODEM_LOCK_SIM_PIN,
+        MM_MODEM_LOCK_SIM_PIN2,
+        MM_MODEM_LOCK_SIM_PUK,
+        MM_MODEM_LOCK_SIM_PUK2,
+    };
+    g_autoptr(MMUnlockRetries) retries = NULL;
+    g_auto(GStrv)              lines = NULL;
+    const gchar               *response;
+    GError                    *error = NULL;
+    guint                      i, n = 0;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    retries = mm_unlock_retries_new ();
+
+    lines = g_strsplit_set (response, "\r\n", -1);
+    for (i = 0; lines[i] && n < G_N_ELEMENTS (locks); i++) {
+        const gchar *line = lines[i];
+
+        while (*line == ' ')
+            line++;
+        if (!g_str_has_prefix (line, "+XX:"))
+            continue;
+
+        mm_unlock_retries_set (retries, locks[n], (guint) atoi (line + strlen ("+XX:")));
+        n++;
+    }
+
+    if (n != G_N_ELEMENTS (locks)) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "Couldn't parse +XX retry counters (%u of %u found)",
+                                 n, (guint) G_N_ELEMENTS (locks));
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_pointer (task, g_steal_pointer (&retries), g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+load_unlock_retries (MMIfaceModem        *self,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+XX=0;+XX=1;+XX=2;+XX=3",
+                              3,
+                              FALSE,
+                              (GAsyncReadyCallback) xx_ready,
+                              task);
+}
+
+/*****************************************************************************/
+/* Supported SMS storages: +CPMS=? comes wrapped in an extra pair of
+ * parentheses, e.g. +CPMS: (("SM"),("SM"),("SM")) */
+
+typedef struct {
+    GArray *mem1;
+    GArray *mem2;
+    GArray *mem3;
+} SupportedStoragesResult;
+
+static void
+supported_storages_result_free (SupportedStoragesResult *result)
+{
+    if (result->mem1)
+        g_array_unref (result->mem1);
+    if (result->mem2)
+        g_array_unref (result->mem2);
+    if (result->mem3)
+        g_array_unref (result->mem3);
+    g_free (result);
+}
+
+static gboolean
+messaging_load_supported_storages_finish (MMIfaceModemMessaging  *self,
+                                          GAsyncResult           *res,
+                                          GArray                **mem1,
+                                          GArray                **mem2,
+                                          GArray                **mem3,
+                                          GError                **error)
+{
+    SupportedStoragesResult *result;
+
+    result = g_task_propagate_pointer (G_TASK (res), error);
+    if (!result)
+        return FALSE;
+
+    *mem1 = g_steal_pointer (&result->mem1);
+    *mem2 = g_steal_pointer (&result->mem2);
+    *mem3 = g_steal_pointer (&result->mem3);
+    supported_storages_result_free (result);
+    return TRUE;
+}
+
+static void
+cpms_test_ready (MMBaseModem  *self,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    SupportedStoragesResult *result;
+    const gchar             *response;
+    g_autofree gchar        *stripped = NULL;
+    g_autofree gchar        *fixed = NULL;
+    gsize                    len;
+    GError                  *error = NULL;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    stripped = g_strdup (mm_strip_tag (response, "+CPMS:"));
+    g_strstrip (stripped);
+    len = strlen (stripped);
+
+    /* Remove the extra outer level, only if present */
+    if (len > 4 && stripped[0] == '(' && stripped[1] == '(' && stripped[len - 1] == ')')
+        fixed = g_strdup_printf ("+CPMS: %.*s", (int) (len - 2), stripped + 1);
+    else
+        fixed = g_strdup_printf ("+CPMS: %s", stripped);
+
+    result = g_new0 (SupportedStoragesResult, 1);
+    if (!mm_3gpp_parse_cpms_test_response (fixed, &result->mem1, &result->mem2, &result->mem3, &error)) {
+        supported_storages_result_free (result);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_pointer (task, result, (GDestroyNotify) supported_storages_result_free);
+    g_object_unref (task);
+}
+
+static void
+messaging_load_supported_storages (MMIfaceModemMessaging *self,
+                                   GAsyncReadyCallback    callback,
+                                   gpointer               user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+CPMS=?",
+                              3,
+                              TRUE,
+                              (GAsyncReadyCallback) cpms_test_ready,
+                              task);
+}
+
+/*****************************************************************************/
+/* Create bearer */
+
+static MMBaseBearer *
+create_bearer_finish (MMIfaceModem  *self,
+                      GAsyncResult  *res,
+                      GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+bearer_new_ready (GObject      *unused,
+                  GAsyncResult *res,
+                  GTask        *task)
+{
+    MMBaseBearer *bearer;
+    GError       *error = NULL;
+
+    bearer = mm_broadband_bearer_unisoc_new_finish (res, &error);
+    if (!bearer)
+        g_task_return_error (task, error);
+    else
+        g_task_return_pointer (task, bearer, g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+create_bearer (MMIfaceModem        *self,
+               MMBearerProperties  *properties,
+               GAsyncReadyCallback  callback,
+               gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_obj_dbg (self, "creating Unisoc bearer...");
+    mm_broadband_bearer_unisoc_new (MM_BROADBAND_MODEM_UNISOC (self),
+                                    properties,
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) bearer_new_ready,
+                                    task);
+}
+
+/*****************************************************************************/
+/* Network time URC: +CTZV: "yy/mm/dd,hh:mm:ss+tz,dst" (tz in quarter hours) */
+
+static void
+ctzv_received (MMPortSerialAt        *port,
+               GMatchInfo            *match_info,
+               MMBroadbandModemUnisoc *self)
+{
+    g_autofree gchar  *raw = NULL;
+    g_autofree gchar  *iso8601 = NULL;
+    MMNetworkTimezone *tz;
+    gint               year, mon, mday, hour, min, sec, tzq, dst;
+    gint               offset_min;
+
+    raw = g_match_info_fetch (match_info, 1);
+    if (!raw)
+        return;
+    g_strdelimit (raw, "\"", ' ');
+    g_strstrip (raw);
+
+    if (sscanf (raw, "%d/%d/%d,%d:%d:%d%d,%d",
+                &year, &mon, &mday, &hour, &min, &sec, &tzq, &dst) != 8) {
+        mm_obj_dbg (self, "couldn't parse +CTZV time '%s'", raw);
+        return;
+    }
+
+    offset_min = tzq * 15;
+
+    iso8601 = g_strdup_printf ("%04d-%02d-%02dT%02d:%02d:%02d%c%02d:%02d",
+                               2000 + year, mon, mday, hour, min, sec,
+                               offset_min < 0 ? '-' : '+',
+                               ABS (offset_min) / 60,
+                               ABS (offset_min) % 60);
+    mm_iface_modem_time_update_network_time (MM_IFACE_MODEM_TIME (self), iso8601);
+
+    tz = mm_network_timezone_new ();
+    mm_network_timezone_set_offset (tz, offset_min);
+    mm_iface_modem_time_update_network_timezone (MM_IFACE_MODEM_TIME (self), tz);
+    g_object_unref (tz);
+}
+
+/*****************************************************************************/
+/* Voice calls.
+ *
+ * Unisoc modems report call state exclusively through ^DSCI URCs:
+ *
+ *   ^DSCI: <id>,<dir>,<stat>,<mode>,<mpty>[,<number>,<type>[,...]]
+ *
+ * with <dir> 0=outgoing 1=incoming, and <stat> using the +CLCC numbering
+ * (0 active, 1 held, 2 dialing, 3 alerting, 4 incoming, 5 waiting, 6 ended).
+ * No RING/+CLIP/+CRING is sent for incoming (VoLTE) calls, and <mode> is 1
+ * for plain voice calls, which the generic +CLCC parser would discard as
+ * data calls. So the modem keeps its own call table fed by ^DSCI and
+ * provides it as the call list, instead of polling +CLCC.
+ *
+ * Also, ATD is answered with a "+CDU:<n>" line before the final OK, which
+ * the generic code would take as an unexpected response and fail the call.
+ */
+
+#define UNISOC_CALL_TABLE_TAG "unisoc-call-table"
+
+static void
+call_info_free (MMCallInfo *info)
+{
+    g_free (info->number);
+    g_slice_free (MMCallInfo, info);
+}
+
+static GHashTable *
+get_call_table (MMBroadbandModemUnisoc *self)
+{
+    GHashTable *table;
+
+    table = g_object_get_data (G_OBJECT (self), UNISOC_CALL_TABLE_TAG);
+    if (!table) {
+        table = g_hash_table_new_full (g_direct_hash, g_direct_equal, NULL,
+                                       (GDestroyNotify) call_info_free);
+        g_object_set_data_full (G_OBJECT (self), UNISOC_CALL_TABLE_TAG, table,
+                                (GDestroyNotify) g_hash_table_unref);
+    }
+    return table;
+}
+
+static gboolean
+load_call_list_finish (MMIfaceModemVoice  *self,
+                       GAsyncResult       *res,
+                       GList             **call_info_list,
+                       GError            **error)
+{
+    GError *inner_error = NULL;
+    GList  *list;
+
+    list = g_task_propagate_pointer (G_TASK (res), &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return FALSE;
+    }
+
+    *call_info_list = list;
+    return TRUE;
+}
+
+static void
+load_call_list (MMIfaceModemVoice   *self,
+                GAsyncReadyCallback  callback,
+                gpointer             user_data)
+{
+    GTask          *task;
+    GHashTable     *table;
+    GHashTableIter  iter;
+    gpointer        value;
+    GList          *list = NULL;
+
+    table = get_call_table (MM_BROADBAND_MODEM_UNISOC (self));
+
+    g_hash_table_iter_init (&iter, table);
+    while (g_hash_table_iter_next (&iter, NULL, &value)) {
+        const MMCallInfo *src = value;
+        MMCallInfo       *dst;
+
+        dst = g_slice_new0 (MMCallInfo);
+        dst->index     = src->index;
+        dst->direction = src->direction;
+        dst->state     = src->state;
+        dst->number    = g_strdup (src->number);
+        list = g_list_append (list, dst);
+    }
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_pointer (task, list, NULL);
+    g_object_unref (task);
+}
+
+static void
+dsci_received (MMPortSerialAt         *port,
+               GMatchInfo             *match_info,
+               MMBroadbandModemUnisoc *self)
+{
+    static const MMCallState states[] = {
+        MM_CALL_STATE_ACTIVE,       /* 0 */
+        MM_CALL_STATE_HELD,         /* 1 */
+        MM_CALL_STATE_DIALING,      /* 2 */
+        MM_CALL_STATE_RINGING_OUT,  /* 3 */
+        MM_CALL_STATE_RINGING_IN,   /* 4 */
+        MM_CALL_STATE_WAITING,      /* 5 */
+        MM_CALL_STATE_TERMINATED,   /* 6 */
+    };
+    g_autofree gchar *payload = NULL;
+    g_auto(GStrv)     fields = NULL;
+    g_autoptr(MMCallList) call_list = NULL;
+    GHashTable       *table;
+    guint             idx, dir, stat;
+
+    payload = g_match_info_fetch (match_info, 1);
+    if (!payload)
+        return;
+
+    fields = g_strsplit (payload, ",", -1);
+    if (g_strv_length (fields) < 3)
+        return;
+
+    idx  = (guint) g_ascii_strtoull (g_strstrip (fields[0]), NULL, 10);
+    dir  = (guint) g_ascii_strtoull (g_strstrip (fields[1]), NULL, 10);
+    stat = (guint) g_ascii_strtoull (g_strstrip (fields[2]), NULL, 10);
+
+    if (!idx || dir > 1 || stat >= G_N_ELEMENTS (states)) {
+        mm_obj_dbg (self, "ignoring unexpected ^DSCI: %s", payload);
+        return;
+    }
+
+    table = get_call_table (self);
+
+    if (states[stat] == MM_CALL_STATE_TERMINATED) {
+        /* A call missing from the list is reported as terminated */
+        g_hash_table_remove (table, GUINT_TO_POINTER (idx));
+    } else {
+        MMCallInfo *info;
+
+        info = g_slice_new0 (MMCallInfo);
+        info->index     = idx;
+        info->direction = dir ? MM_CALL_DIRECTION_INCOMING : MM_CALL_DIRECTION_OUTGOING;
+        info->state     = states[stat];
+
+        if (g_strv_length (fields) >= 6) {
+            gchar *number;
+
+            number = g_strdup (g_strstrip (fields[5]));
+            g_strdelimit (number, "\"", ' ');
+            g_strstrip (number);
+            if (g_ascii_strncasecmp (number, "sip:", 4) == 0) {
+                gchar *stripped, *at;
+
+                stripped = g_strdup (number + 4);
+                at = strchr (stripped, '@');
+                if (at)
+                    *at = '\0';
+                g_free (number);
+                number = stripped;
+            }
+            if (number[0])
+                info->number = number;
+            else
+                g_free (number);
+        }
+
+        mm_obj_dbg (self, "call %u: direction %s, state %s%s%s",
+                    info->index,
+                    mm_call_direction_get_string (info->direction),
+                    mm_call_state_get_string (info->state),
+                    info->number ? ", number " : "",
+                    info->number ? info->number : "");
+        g_hash_table_replace (table, GUINT_TO_POINTER (idx), info);
+    }
+
+    /* Only report if the voice interface is already up and running */
+    g_object_get (self, MM_IFACE_MODEM_VOICE_CALL_LIST, &call_list, NULL);
+    if (!call_list)
+        return;
+
+    mm_iface_modem_voice_reload_all_calls (MM_IFACE_MODEM_VOICE (self), NULL, NULL);
+}
+
+static void
+setup_ports (MMBroadbandModem *self)
+{
+    g_autoptr(GRegex) ctzv_regex = NULL;
+    g_autoptr(GRegex) dsci_regex = NULL;
+    g_autoptr(GRegex) cdu_regex = NULL;
+    g_autoptr(GRegex) cesq_regex = NULL;
+    g_autoptr(GRegex) noise_regex = NULL;
+    MMPortSerialAt   *ports[2];
+    guint             i;
+
+    /* Always chain up first */
+    MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_unisoc_parent_class)->setup_ports (self);
+
+    ctzv_regex = g_regex_new ("\\r\\n\\+CTZV:\\s*(.*)\\r\\n", G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (ctzv_regex);
+
+    dsci_regex = g_regex_new ("\\r\\n\\^DSCI:\\s*([^\\r\\n]*)\\r\\n", G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (dsci_regex);
+
+    /* Sent before the final OK of ATD; just swallow it */
+    cdu_regex = g_regex_new ("\\r\\n\\+CDU:[^\\r\\n]*\\r\\n", G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (cdu_regex);
+
+    /* +CESQ: only the numeric form (URC and AT+CESQ answer), not the +CESQ=? one */
+    cesq_regex = g_regex_new ("\\r\\n\\+CESQ:\\s*\\d+,\\d+,\\d+,\\d+,\\d+,\\d+[^\\r\\n]*\\r\\n", G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (cesq_regex);
+
+    /* Vendor URCs without any meaning for MM. Left unhandled they would be
+     * glued to the response of the next command. */
+    noise_regex = g_regex_new ("\\r\\n(?:\\+CSQ|\\+SIND|\\+ECIND|\\+SPCDIP|\\+SPCHRU|\\+SPERRLOG|\\+EARLYMEDIA|"
+                               "\\+CDUU|\\+SPIMSPDPINFO|\\+SPPCODATA|\\^CONN|\\^CEND):[^\\r\\n]*\\r\\n",
+                               G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    g_assert (noise_regex);
+
+
+    ports[0] = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
+    ports[1] = mm_base_modem_peek_port_secondary (MM_BASE_MODEM (self));
+
+    for (i = 0; i < G_N_ELEMENTS (ports); i++) {
+        if (!ports[i])
+            continue;
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       ctzv_regex,
+                                                       (MMPortSerialAtUnsolicitedMsgFn) ctzv_received,
+                                                       self,
+                                                       NULL);
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       dsci_regex,
+                                                       (MMPortSerialAtUnsolicitedMsgFn) dsci_received,
+                                                       self,
+                                                       NULL);
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       cdu_regex,
+                                                       NULL,
+                                                       NULL,
+                                                       NULL);
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       cesq_regex,
+                                                       (MMPortSerialAtUnsolicitedMsgFn) cesq_received,
+                                                       self,
+                                                       NULL);
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       noise_regex,
+                                                       NULL,
+                                                       NULL,
+                                                       NULL);
+    }
+}
+
+/*****************************************************************************/
+
+MMBroadbandModemUnisoc *
+mm_broadband_modem_unisoc_new (const gchar  *device,
+                               const gchar  *physdev,
+                               const gchar **drivers,
+                               const gchar  *plugin,
+                               guint16       vendor_id,
+                               guint16       product_id)
+{
+    return g_object_new (MM_TYPE_BROADBAND_MODEM_UNISOC,
+                         MM_BASE_MODEM_DEVICE,     device,
+                         MM_BASE_MODEM_PHYSDEV,    physdev,
+                         MM_BASE_MODEM_DRIVERS,    drivers,
+                         MM_BASE_MODEM_PLUGIN,     plugin,
+                         MM_BASE_MODEM_VENDOR_ID,  vendor_id,
+                         MM_BASE_MODEM_PRODUCT_ID, product_id,
+                         /* Control over AT, data over net interfaces */
+                         MM_BASE_MODEM_DATA_NET_SUPPORTED, TRUE,
+                         MM_BASE_MODEM_DATA_TTY_SUPPORTED, FALSE,
+                         /* +CIND is not used for signal reporting on these modems */
+                         MM_BROADBAND_MODEM_INDICATORS_DISABLED, TRUE,
+                         /* Incoming VoLTE calls come with an empty +CLIP: reload
+                          * the call list from +CLCC on ring instead */
+                         MM_IFACE_MODEM_VOICE_INDICATION_CALL_LIST_RELOAD_ENABLED, TRUE,
+                         NULL);
+}
+
+static void
+mm_broadband_modem_unisoc_init (MMBroadbandModemUnisoc *self)
+{
+}
+
+static void
+iface_modem_init (MMIfaceModemInterface *iface)
+{
+    iface->load_power_state               = load_power_state;
+    iface->load_power_state_finish        = load_power_state_finish;
+    iface->modem_power_up                 = modem_power_up;
+    iface->modem_power_up_finish          = modem_power_change_finish;
+    iface->modem_after_power_up           = modem_after_power_up;
+    iface->modem_after_power_up_finish    = modem_after_power_up_finish;
+    iface->modem_power_down               = modem_power_down;
+    iface->modem_power_down_finish        = modem_power_change_finish;
+    iface->modem_power_off                = modem_power_off;
+    iface->modem_power_off_finish         = modem_power_change_finish;
+    iface->load_signal_quality            = load_signal_quality;
+    iface->load_signal_quality_finish     = load_signal_quality_finish;
+    iface->load_unlock_retries            = load_unlock_retries;
+    iface->load_unlock_retries_finish     = load_unlock_retries_finish;
+    iface->create_bearer                  = create_bearer;
+    iface->create_bearer_finish           = create_bearer_finish;
+}
+
+static void
+iface_modem_messaging_init (MMIfaceModemMessagingInterface *iface)
+{
+    iface->load_supported_storages        = messaging_load_supported_storages;
+    iface->load_supported_storages_finish = messaging_load_supported_storages_finish;
+}
+
+static void
+iface_modem_voice_init (MMIfaceModemVoiceInterface *iface)
+{
+    iface->load_call_list        = load_call_list;
+    iface->load_call_list_finish = load_call_list_finish;
+}
+
+static void
+mm_broadband_modem_unisoc_class_init (MMBroadbandModemUnisocClass *klass)
+{
+    MMBroadbandModemClass *broadband_modem_class = MM_BROADBAND_MODEM_CLASS (klass);
+
+    broadband_modem_class->setup_ports = setup_ports;
+}
