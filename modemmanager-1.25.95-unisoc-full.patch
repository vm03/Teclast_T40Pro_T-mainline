diff -ruN a/src/plugins/unisoc/77-mm-unisoc-soc.rules b/src/plugins/unisoc/77-mm-unisoc-soc.rules
--- a/src/plugins/unisoc/77-mm-unisoc-soc.rules	1970-01-01 00:00:00.000000000 +0000
+++ b/src/plugins/unisoc/77-mm-unisoc-soc.rules	2026-10-24 17:32:03.943180020 +0000
@@ -0,0 +1,78 @@
+# do not edit this file, it will be overwritten on update
+
+ACTION!="add|change|move|bind", GOTO="mm_unisoc_soc_end"
+
+# Unisoc/Spreadtrum SoC modems (sprd-modem + rpmsg-wwan-net drivers).
+#
+# Each SIM slot is a separate modem object with three AT channels (see the
+# Android RIL, which uses them this way): the first one (wwan0at0 / wwan0at3)
+# is where ALL unsolicited messages are sent, and nothing else is expected on
+# it; the second (wwan0at1 / wwan0at4) is the command channel; the third
+# (wwan0at2 / wwan0at5) is a spare command channel. Using the command channel
+# as primary port keeps the answers free of unsolicited messages, while the
+# first channel is listened to as secondary port.
+#
+# Net interface N of a slot carries PDP context (cid) N, which the bearer finds
+# through ID_MM_UNISOC_NET_CID.
+#
+# Optional properties, to be set by other rules processed before this file:
+#   ID_MM_UNISOC_KEEP_MODE=1            keep the default network mode of SIM slot 2
+#   ID_MM_UNISOC_NO_VENDOR_INIT=1       don't send the vendor init commands (the
+#                                       "quiet" notification profile, ^DSCI, ...)
+
+# Stage 1: identify slot and role of each port
+
+# SIM slot 1: URC channel at0, command channel at1 (at2 is left alone)
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at1", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at1", ENV{ID_MM_PORT_TYPE_AT_PRIMARY}="1"
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at0", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at0", ENV{ID_MM_PORT_TYPE_AT_SECONDARY}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte0", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte0", ENV{ID_MM_UNISOC_NET_CID}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte1", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte1", ENV{ID_MM_UNISOC_NET_CID}="2"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte2", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte2", ENV{ID_MM_UNISOC_NET_CID}="3"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte3", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte3", ENV{ID_MM_UNISOC_NET_CID}="4"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte4", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte4", ENV{ID_MM_UNISOC_NET_CID}="5"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte5", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte5", ENV{ID_MM_UNISOC_NET_CID}="6"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte6", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte6", ENV{ID_MM_UNISOC_NET_CID}="7"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte7", ENV{ID_MM_UNISOC_SLOT}="0"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte7", ENV{ID_MM_UNISOC_NET_CID}="8"
+# SIM slot 2: URC channel at3, command channel at4 (at5 is left alone)
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at4", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at4", ENV{ID_MM_PORT_TYPE_AT_PRIMARY}="1"
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at3", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", KERNEL=="wwan*at3", ENV{ID_MM_PORT_TYPE_AT_SECONDARY}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte8", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte8", ENV{ID_MM_UNISOC_NET_CID}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte9", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte9", ENV{ID_MM_UNISOC_NET_CID}="2"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte10", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte10", ENV{ID_MM_UNISOC_NET_CID}="3"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte11", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte11", ENV{ID_MM_UNISOC_NET_CID}="4"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte12", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte12", ENV{ID_MM_UNISOC_NET_CID}="5"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte13", ENV{ID_MM_UNISOC_SLOT}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ATTRS{name}=="seth_lte13", ENV{ID_MM_UNISOC_NET_CID}="6"
+
+# Stage 2: any other port of these drivers (e.g. the spare command channels)
+# must not be grabbed by other plugins (e.g. generic) and turned into extra modems
+SUBSYSTEM=="wwan", DRIVERS=="sprd-modem", ENV{ID_MM_UNISOC_SLOT}!="0", ENV{ID_MM_UNISOC_SLOT}!="1", ENV{ID_MM_PORT_IGNORE}="1"
+SUBSYSTEM=="net", DRIVERS=="rpmsg-wwan-net", ENV{ID_MM_UNISOC_SLOT}!="0", ENV{ID_MM_UNISOC_SLOT}!="1", ENV{ID_MM_PORT_IGNORE}="1"
+
+ENV{ID_MM_UNISOC_SLOT}!="0", ENV{ID_MM_UNISOC_SLOT}!="1", GOTO="mm_unisoc_soc_end"
+
+# One modem object per SIM slot
+ENV{ID_MM_UNISOC_SLOT}=="0", ENV{ID_MM_PHYSDEV_UID}="unisoc-soc-0"
+ENV{ID_MM_UNISOC_SLOT}=="1", ENV{ID_MM_PHYSDEV_UID}="unisoc-soc-1"
+
+ENV{ID_MM_UNISOC_SOC}="1"
+ENV{ID_MM_CANDIDATE}="1"
+
+LABEL="mm_unisoc_soc_end"
diff -ruN a/src/plugins/unisoc/README.md b/src/plugins/unisoc/README.md
--- a/src/plugins/unisoc/README.md	1970-01-01 00:00:00.000000000 +0000
+++ b/src/plugins/unisoc/README.md	2026-10-24 17:32:03.943146215 +0000
@@ -0,0 +1,591 @@
+# Модем Unisoc (Spreadtrum) в ModemManager: что выяснено из Android-стрейсов
+
+Этот файл описывает всё, что удалось понять из пяти стрейсов процесса RIL
+(`urild`) на Android-прошивке того же устройства (Telcast Z3D1 / T40, SoC Unisoc
+с модемом `65003400.modem`), и как это использовано в плагине `unisoc`.
+
+Источники и степень уверенности:
+
+* **наблюдалось** — прямо видно в стрейсах (команды, ответы, время);
+* **вывод** — логически следует из наблюдений, но прямо нигде не написано;
+* **предположение** — гипотеза, которую надо проверять на устройстве.
+
+Документации Unisoc на AT-команды у меня не было, значения вендорных команд
+ниже — это то, что следует из контекста их использования в RIL. Там, где смысл
+не ясен, так и написано.
+
+## 1. Что было записано
+
+| Файл | Что делали на Android |
+|---|---|
+| `urild_strace2.txt` | старт RIL (полная инициализация), затем экран выкл/вкл |
+| `urild_strace3.txt` | несколько раз экран выкл/вкл |
+| `urild_strace4.txt` | несколько раз `dumpsys deviceidle force-idle` |
+| `urild_strace5.txt` | включение и выключение режима полёта |
+| `urild_strace6.txt` | USSD с SIM1, затем с SIM2 |
+
+В стрейсе видны `read`/`write` на `/dev/stty_lte0…5` (AT-обмен), а также
+сообщения самого RIL в logd (`writev` в сокет), по которым можно понять, какое
+событие Android вызвало те или иные команды (`sendDeviceState`,
+`setRadioPower`, …). Звонки и SMS в стрейсах не записаны.
+
+## 2. Главное открытие: у модема шесть AT-каналов, и у каждого своя роль
+
+Наблюдалось (статистика по всем стрейсам):
+
+| Канал | Что RIL делает | Что приходит |
+|---|---|---|
+| `stty_lte0` | **только читает** | **все URC SIM1** (`+CESQ`, `+CREG`, `+CEREG`, `+CGEV`, `+CUSD`, `^DSCI`, `+CTZV`, `^CONN`, `^CEND`, `+SPQAM`, `+SPBARINFO`, `+SPNRCHANNELU`, `+SPPCI`, `+SPNWNAME`, `+PRENWINFU`, `+SPCHRU`, `+CIREGU`, `+ECIND`…) |
+| `stty_lte1` | команды SIM1 | ответы на команды; **ни одного настоящего URC** |
+| `stty_lte2` | запасной командный канал SIM1 | ответы (`SFUN=5`, `CLCK`, `SPCCHO`, `IMSSTACKVERSION?`, `SPPAURI?`, `CASIMS?` …) |
+| `stty_lte3` | только читает | все URC SIM2 |
+| `stty_lte4` | команды SIM2 | ответы |
+| `stty_lte5` | запасной командный канал SIM2 | ответы |
+
+Вывод: канал 0/3 — «шина уведомлений», 1/4 — основной командный канал,
+2/5 — запасной командный канал (RIL отправляет туда долгие или фоновые запросы,
+чтобы не блокировать основной). Соответствие SIM → каналы: SIM1 = 0/1/2,
+SIM2 = 3/4/5 (SIM2-команды и ответы на USSD SIM2 идут именно по 4 и 3).
+
+Предположение, которое согласуется с логами MM: на Linux порты
+`/dev/wwan0at0…5` соответствуют `stty_lte0…5`. Подтверждение: MM, который
+сидит на `wwan0at0` / `wwan0at3`, получает именно такой поток URC.
+
+### Почему это важно
+
+До этого MM использовал `wwan0at0` / `wwan0at3` — то есть **канал URC** — и как
+командный. Из-за этого URC постоянно «склеивались» с ответами на команды.
+Именно это объясняет целый ряд ошибок, которые мы раньше чинили по одной:
+
+* `Invalid USSD message received: '+SPQAM: 1'` — URC попал в ответ на `AT+CUSD`;
+* `Missing +CRSM prefix` — перед ответом на `AT+CRSM` пришёл `+PRENWINFU`;
+* `Unhandled response '+CDU:1'`, `... '+CSQ: ...'` и ошибка `ATA` — тот же класс;
+* пропадающие/«зависающие» ответы на частые запросы.
+
+Исправление: **первичным AT-портом сделан командный канал (`at1` / `at4`), а
+каналы URC (`at0` / `at3`) — вторичным** (см. `77-mm-unisoc-soc.rules`). MM
+ставит обработчики URC и на первичный, и на вторичный порт, поэтому
+уведомления продолжают обрабатываться. Запасные каналы `at2` / `at5`
+игнорируются (или могут использоваться внешними скриптами, см. п. 12).
+Старые обходные фильтры «мусорных» URC в плагине оставлены как страховка.
+
+## 3. Последовательность запуска RIL (`urild_strace2.txt`)
+
+Наблюдалось. Полный список команд — в приложении A. Основные этапы:
+
+1. **Ещё до SIM.** `AT+SMMSWAP=0`, `AT+CMUX=0`, `AT+SPCARDINFO=2,1,0` (SIM2),
+   `ATS0=0`, `AT+CREG=2`, `AT+SPCAPABILITY=51,0`, `AT+CSSN=1,1`, `AT+COLP=0`,
+   `AT+CUSD=1`, `AT+CMGF=0`, `AT+CRC=1`, `AT+CGPIAF=1`, `AT+SPREGFAIL=1`,
+   `AT+CNMI=3,2,2,1,1`, `AT+SPPSEUDOBS=1`, `AT+SPCHRSWITCH=1`, `AT^DSCI=1`,
+   `AT+VTD=1`, `AT+SPVIDEOTYPE=3`, `AT+SPVOLTEENG=119,1,"1"`.
+   Модем при этом в `+CFUN: 0` (так отвечает в начале стрейса).
+2. **SIM.** `AT+XX=0/1/3` (счётчики PIN/PUK), `AT+SPATR?`, `AT+CCID?` (на
+   каждой SIM), `AT+CEN?`, `AT+SPDUMMY="set ctm",0`, `AT+ISIM=1`.
+3. **Радио.** `AT+SFUN=5` (на запасном канале), затем `AT+SGMR=0,0,2`,
+   `AT+CEMODE=1`, `AT+SPLTEMANUATT=0` и `AT+SFUN=4` на **каждой** SIM.
+4. **После включения радио.** `AT+IMSSTACKVERSION?`, `AT+CLCK="FD"/"SC",2`,
+   `AT+SPCCHO` (UICC), `AT+EUICC?`, `AT+SPUSAT*` (SIM Toolkit), `AT+CTZR=1`,
+   `AT+CGREG=2`, `AT+SPNRCHANNEL=1`, `AT+SPNRCFGINFO=1`, `AT+SPBARINFO=1`,
+   `AT+CIREP=1`, `AT+CIREG=2`.
+5. **Данные и IMS.** `AT+CGACT=0,1` (SIM2), `AT+SPSWDATA` (SIM1),
+   `AT+CGDCONT=11,"IP","IMS"`, `AT+CGPCO`, `AT+SPCGAPNCFG`, `AT+CGEQREQ`,
+   `AT+CGDATA="M-ETHER",1` (SIM1) — подробности в п. 7 и 8.
+6. **Начальное состояние «экран выключен»** (`AT+CCED=2,8` …) — п. 5.
+
+## 4. Питание радио: `AT+SFUN`
+
+Наблюдалось:
+
+* старт: `+CFUN: 0`; затем `AT+SFUN=5`, потом `AT+SFUN=4`;
+* режим полёта **вкл**: RIL получает `DEACTIVATE_DATA_CALL`, но AT-команды
+  для этого в стрейсе нет (механизм неизвестен, **предположение**: не через
+  AT-канал), затем отправляется **один** `AT+SFUN=5`; регистрация пропадает
+  **у обоих** слотов (`+CREG: 2,0`, `+CEREG: 2,0` на обеих SIM), и уже после
+  `SFUN=5` приходят `+CGEV: NW PDN DEACT 1` и `^CEND`;
+* режим полёта **выкл**: `AT+SFUN=4` на каждой SIM.
+
+Вывод: `SFUN=5` — «радио выключено, SIM доступна» (в oFono это offline) и
+действует **на весь модем сразу**, `SFUN=4` — радио включено.
+
+Следствие для MM: два модемных объекта (SIM1 и SIM2) делят одно радио. Раньше
+отключение одного из них (например, SIM2 в состоянии `sim-missing`) посылало
+`SFUN=5` и **гасило радио второго слота**. Теперь плагин считает, сколько
+модемов нуждается в радио, и шлёт `SFUN=5` только когда выключается последний.
+
+Радио включается только при включении модема (`enable`), а не заранее: см.
+п. 15 (попытка включить его в начале инициализации привела к зависанию модема).
+
+## 5. Экран выкл/вкл: что RIL говорит модему
+
+RIL получает от Android `sendDeviceState` / `SCREEN_STATE` /
+`setIndicationFilter` и отправляет модему наборы команд. Наблюдалось
+(`urild_strace3.txt`, `urild_strace4.txt`; `force-idle` просто вызывает ту же
+логику «экран выкл/вкл»):
+
+**Экран выключен** (на обеих SIM, часть команд может идти только на одну):
+
+```
+AT+CCED=2,8          AT*FDY=1,2            AT+SPEDDAENABLE=1
+AT+CREG=1            AT+CGREG=1            AT+CEREG=1
+AT+SPNRCHANNEL=0     AT+SPPSEUDOBS=0       AT+CSCON=0
+AT+SPNRCFGINFO=0     AT+SPBARINFO=0        AT+CIREP=0
+AT+CIREG=1           AT+SPVOICEPREFER=1
+```
+
+**Экран включён** — обратные значения:
+
+```
+AT+CCED=1,8          AT*FDY=1,5            AT+SPEDDAENABLE=0
+AT+CEREG=2 (CREG/CGREG=2)                  AT+SPNRCHANNEL=1
+AT+SPNRCFGINFO=1     AT+SPBARINFO=1        AT+CIREP=1
+AT+CIREG=2           AT+SPVOICEPREFER=0    AT+CSCON=0
+```
+
+### Что это даёт (измерено)
+
+Число URC на каналах 0/3 в `urild_strace3.txt` (по 10-секундным интервалам):
+пока экран включён — `+CESQ` примерно 6 штук за 10 с; в интервале
+«экран выключен» (22:53:24 – 22:54:38) `+CESQ` не приходит совсем, остаются
+редкие `+SPQAM`. В Linux с MM `+CSQ`/`+CESQ` идут несколько раз в секунду.
+
+Вывод: `AT+CCED=2,8` отключает периодические отчёты об уровне сигнала
+(`+CESQ`/`+CSQ`), остальные команды отключают вендорные URC
+(`+SPBARINFO`, `+SPNRCHANNELU`, `+SPPSEUDOBS`, `+SPNRCFGINFO`, `+CIREPI`/`CIREG`).
+Это почти наверняка и есть причина «устройство не засыпает после запуска
+ModemManager»: пока радио включено, модем присылает URC постоянно, а до первого
+запуска (радио выключено) их нет. Что именно в ядре превращает это в
+пробуждение, из стрейсов не видно.
+
+Что значат остальные команды — **не ясно**: `AT*FDY=1,<n>` похоже на быстрый
+переход в dormant (n = таймер), `SPEDDAENABLE`, `SPVOICEPREFER` — неясно.
+
+Что сделано в плагине: после включения радио отправляются «тихие» команды
+`CCED=2,8`, `SPBARINFO=0`, `SPNRCHANNEL=0`, `SPPSEUDOBS=0`, `SPNRCFGINFO=0`,
+`CSCON=0`, `CIREP=0` (всё, что MM не использует). Уровень сигнала MM и так
+опрашивает сам командой `AT+CESQ`. Отключается udev-свойством
+`ID_MM_UNISOC_NO_VENDOR_INIT=1`. `FDY`, `SPEDDAENABLE`, `SPVOICEPREFER` не
+трогаем, так как их смысл неизвестен.
+
+## 6. Что MM отправлял не так, как RIL
+
+* `ATZ`, `AT&C1`, `ATX4` (RIL их не отправляет): `ATZ` сбрасывает настройки
+  модема к умолчаниям; возможно, поэтому в Linux видны `+CSQ`-URC, которых нет
+  в Android (там только `+CESQ`). **Предположение**, не проверялось.
+* Регистрация `AT+CREG/CGREG=2` (RIL на время «экран выкл» ставит 1): MM
+  нужен уровень 2 (идентификатор ячейки/области), поэтому не меняем.
+
+## 7. Передача данных
+
+Наблюдалось (SIM1, `urild_strace2.txt`, `urild_strace5.txt`):
+
+```
+AT+CGDCONT=1,"IPV4V6","internet.beeline.ru","",0,0,0,0,1
+AT+CGPCO=0,"beeline","beeline",1,3
+AT+SPCGAPNCFG=1,"internet.beeline.ru","IPV4V6","IPV4V6",0,"beeline","beeline",3
+AT+CGEQREQ=1,2,0,0,0,0,2,0,"1e4","0e0",3,0,0
+AT+CGDATA="M-ETHER",1
+   -> ^ORIG: 1,2 / CONNECT
+AT+CGCONTRDP=1
+   -> +CGCONTRDP: 1,5,<apn>,10.73.244.120.255.0.0.0,,172.23.10.130,172.23.10.131,...
+```
+
+* Отдельного `AT+CGACT=1` нет: **`AT+CGDATA` сам активирует контекст** и
+  сразу переводит интерфейс в режим данных (`M-ETHER`, у oFono и у нашего
+  плагина `M-IP`; данные у вас работают, поэтому оставлено как есть).
+* В ответе `+CGCONTRDP` адрес и маска идут одним полем в формате
+  `a.b.c.d.m.m.m.m`, **шлюз пустой**, DNS — 5-е и 6-е поля. Наш разбор это
+  уже учитывает (пустой шлюз допускается).
+* `AT+SPCGAPNCFG=1,...` задаёт APN первичного (attach) контекста; последний
+  параметр (`3`/`1`) — вероятно, тип аутентификации.
+* Данные использует **одна SIM**: при старте RIL отключает контекст SIM2
+  (`AT+CGACT=0,1` на канале SIM2) и выбирает SIM данных командой
+  `AT+SPSWDATA` на канале SIM1 (так же после каждого выхода из режима
+  полёта). Смысл `SPSWDATA` — **предположение** (выбор SIM данных).
+* В `urild_strace5.txt` при включении режима полёта RIL получает
+  `DEACTIVATE_DATA_CALL` (AT-команды `CGACT=0` в стрейсе нет), затем идёт
+  `SFUN=5`, и после него приходят `+CGEV: NW PDN DEACT 1` и `^CEND`.
+
+В плагине: слот 0 после включения радио отправляет `AT+SPSWDATA` (как RIL),
+остальное оставлено как работало.
+
+## 8. IMS / VoLTE
+
+Наблюдалось: RIL сам конфигурирует IMS-контекст: `AT+CGDCONT=11,"IP","IMS"`
+(SIM2: `"IPV4V6","ims"`) + `AT+CGPCO` + `AT+CGEQREQ=11`, опрашивает
+`AT+CASIMS?`, `AT+CAVIMS?`, `AT+IMSSTACKVERSION?`, `AT+SPPAURI?`,
+`AT+SPSMSCFG=0,1,""` и включает отчёты `AT+CIREG=2`, `AT+CIREP=1`.
+Статус: у SIM1 на LTE `+CIREG: 2,1,0` (IMS зарегистрирован), у SIM2
+`+CIREG: 2,0,0` (не зарегистрирован, SIM2 на 2G/CS).
+
+В логах MM нет ни `AT+CIREG`, ни этих настроек. Вывод: на Linux мы не знаем,
+зарегистрирован ли IMS, и не настраиваем его. Это объясняет, почему на LTE
+USSD в Linux часто возвращает `+CUSD: 4` (не поддерживается), тогда как у
+Android на LTE он идёт через IMS и отвечает за 0.8 с. Плагин IMS не
+настраивает: APN IMS зависит от оператора (`IMS` / `ims`), правильный набор
+команд надо подбирать отдельно.
+
+## 9. Чтение ICCID и «прыгающие» модемы
+
+Наблюдалось: RIL читает ICCID командой **`AT+CCID?`**, и она возвращает
+правильное значение для каждой SIM с самого начала (`8970199260425705792F` для
+SIM1, `8999804231020553800F` для SIM2) — даже в `+CFUN: 0`.
+
+В логах MM при инициализации ICCID читается через `AT+CRSM=176,12258,0,0,10`, и
+слот 2 при этом отдавал ICCID слота 1 (`980791290624755097F2`), а после
+`SFUN=4` — свой (`989908241320503508F0`). MM принимал это за замену SIM и
+пересоздавал модем (`modem1` превращался в `modem3`).
+
+Вывод: до включения радио `CRSM` на втором слоте неинформативен, а
+`AT+CCID?` — информативен. Плагин теперь читает ICCID командой `AT+CCID?`
+(класс `MMSimUnisoc`, при ошибке — обычный `CRSM`), поэтому ложной «замены SIM»
+и пересоздания модема быть не должно. Раньше для этого я пробовал включать
+радио в начале инициализации — это было ошибкой, см. п. 15.
+
+## 10. USSD
+
+Наблюдалось (`urild_strace6.txt`):
+
+```
+SIM1:  AT+CUSD=1,"2A31303223",15            (hex ASCII от "*102#", dcs 15)
+       ~0.8 с на канале 0:
+       +CUSD: 2,"00320032002E0038003800...",72      (UCS-2 hex, dcs 72, n=2)
+SIM2:  AT+CUSD=1,"2A31303223",15
+       RAT меняется на 2G (+CREG: ...,3) — модем сам делает CSFB
+       ~6.6 с на канале 3:
+       +CUSD: 1,"42616C616E733A20...",...           (hex ASCII, n=1)
+отмена: AT+CUSD=2
+```
+
+* Запрос — **hex от ASCII** с dcs 15. У нас (`CSCS="IRA"`) работает и обычный
+  текст (`AT+CUSD=1,"*102#",15`), он оставлен; упакованный GSM7-hex, который
+  мы пробовали по образцу oFono, сеть отвергает.
+* Ответы приходят **только на канал URC** (0/3), а не на тот, куда отправлена
+  команда.
+* Ответ может быть: UCS-2 в hex (dcs 72, SIM1/Beeline RU), либо hex от
+  ASCII (SIM2, когда запрос тоже ушёл в hex), либо обычный текст (когда запрос
+  был обычным текстом; так в логах MM).
+* Статус `n=2` ("terminated by network") приходит **вместе с текстом**: MM его
+  раньше считал ошибкой и отбрасывал текст (исправлено в ядре MM).
+* SIM1 на LTE отвечает через IMS; SIM2 на LTE уходит на 2G (CSFB), поэтому
+  ответ идёт долго и иногда запрос отклоняется (`+CUSD: 4`).
+
+Плагин декодирует все три формата ответа (UCS-2 hex, hex ASCII, обычный
+текст).
+
+## 11. SMS и голосовые вызовы
+
+* SMS: RIL ставит `AT+CMGF=0`, `AT+CNMI=3,2,2,1,1` (новые сообщения идут
+  сразу в `+CMT`, не сохраняясь, плюс отчёты `+CDS`). MM ставит
+  `AT+CNMI=2,1,2,1,0` (сообщение сохраняется на SIM и приходит `+CMTI`).
+  На SIM всего 10 ячеек (6 заняты), поэтому при заполнении хранилища SMS могут
+  не приниматься — это стоит помнить; `+CMGW: ME is full` в стрейсе — это
+  состояние памяти телефона (ME).
+* Формат `+CMGL` в Linux-логах: между заголовком и PDU **пустая строка**
+  (не видно в стрейсе, найдено в логах MM); парсер исправлен.
+* Голос: RIL включает `AT^DSCI=1`, `AT+CRC=1`, `AT+COLP=0`, `AT+CSSN=1,1`,
+  `AT+VTD=1`. Звонки в стрейсах не записаны. Плагин отправляет `AT^DSCI=1`
+  (на него опирается обработка вызовов).
+
+## 12. Как переключать «экран выкл/вкл» из своих скриптов
+
+Основные порты (`at1`/`at4` и URC-порты `at0`/`at3`) занимает MM, а запасные
+каналы `at2` (SIM1) и `at5` (SIM2) MM **не использует** — через них можно
+безопасно отправлять команды из скриптов (так делает и сам RIL).
+Пример (проверялся только на логике, не на устройстве):
+
+```sh
+#!/bin/sh
+# unisoc-screen-state.sh off|on
+at() { printf '%s\r' "$2" > "$1"; sleep 0.05; }
+case "$1" in
+off) cmds='AT+CCED=2,8 AT*FDY=1,2 AT+SPEDDAENABLE=1 AT+CREG=1 AT+CGREG=1 AT+CEREG=1 AT+SPNRCHANNEL=0 AT+SPPSEUDOBS=0 AT+CSCON=0 AT+SPNRCFGINFO=0 AT+SPBARINFO=0 AT+CIREP=0 AT+CIREG=1' ;;
+on)  cmds='AT+CCED=1,8 AT*FDY=1,5 AT+SPEDDAENABLE=0 AT+CREG=2 AT+CGREG=2 AT+CEREG=2 AT+SPNRCHANNEL=1 AT+SPNRCFGINFO=1 AT+SPBARINFO=1 AT+CIREP=1 AT+CIREG=2' ;;
+esac
+for dev in /dev/wwan0at2 /dev/wwan0at5; do
+  exec 3>"$dev"
+  for c in $cmds; do printf '%s\r' "$c" >&3; sleep 0.05; done
+  exec 3>&-
+done
+```
+
+Внимание: `CREG/CGREG/CEREG=1` меняют уровень регистрации, который использует
+MM (для идентификатора ячейки), — если это важно, уберите их из набора.
+Ответы модема из скрипта не читаются.
+
+## 13. Что остаётся неясным
+
+* Смысл `AT+SPQAM` URC (приходит парами 0/1 при смене состояния радио),
+  `+SPCHRU`, `AT+SPPWS=2,2,2,1`, `AT+SPCARDINFO=2,1,0`,
+  `AT+SPVOLTEENG=119,1,"1"`, `AT*FDY`, `AT+SPEDDAENABLE`.
+* Что именно заставляет модем «зависать» на SIM2: известно только, что после
+  запуска MM слот SIM2 стоит в режиме `10` (2G only), и без смены режима
+  AT-порт слота 1 перестаёт отвечать. RIL при старте SIM2 в режимах
+  `SPTESTMODE` не трогает (команда в стрейсах не встречается), но использует
+  `SPCARDINFO`, `SPSWDATA`, `CGACT=0,1` для SIM2, которых у нас нет.
+* Механизм пробуждений ядра: из стрейсов виден только поток URC.
+
+## 14. Что изменено в плагине по результатам стрейсов
+
+| Находка | Изменение |
+|---|---|
+| Каналы 0/3 — только URC, 1/4 — команды | порты в udev: `at1`/`at4` первичные, `at0`/`at3` вторичные, `at2`/`at5` игнорируются |
+| `SFUN=5` общий для обоих слотов | `SFUN=5` только когда выключается последний модем |
+| Экран выкл — URC прекращаются | «тихий» набор команд после включения радио (`CCED=2,8` …) |
+| `AT^DSCI=1`, `AT+CTZR=1` у RIL | отправляются после включения радио |
+| `AT+SPSWDATA` у RIL | отправляется слотом 0 после включения радио |
+| ICCID через `CCID?` корректен всегда, `CRSM` до `SFUN=4` — нет | ICCID читается через `AT+CCID?` (`mm-sim-unisoc.c`) |
+| RIL проверяет только блокировки `SC` и `FD` | остальные блокировки (`PS`, `PN`, `PU`, `PP`, `PC`) не запрашиваются |
+| RIL до `SFUN=4` отправляет `AT+SPCARDINFO=2,1,0` (SIM2) | то же перед `SFUN=4` для слота 2 |
+| Смена режима SIM2 при старте | делается через 10 с после включения радио, а не во время инициализации |
+| USSD: ответ hex ASCII / UCS-2 / текст | декодер понимает все три |
+
+Свойства udev (задаются другими правилами до этого файла):
+
+* `ID_MM_UNISOC_NO_VENDOR_INIT=1` — не отправлять стартовые вендорные
+  команды (`DSCI`, `CTZR`, «тихие», `SPSWDATA`);
+* `ID_MM_UNISOC_KEEP_MODE=1` — не переключать SIM2 автоматически из режима
+  2G в автоматический.
+
+## 15. Регрессия при старте и что в ней выяснено
+
+После версии, в которой радио включалось (`AT+SFUN=4`) в самом начале
+инициализации (чтобы правильно прочитать ICCID), модем при старте MM начал
+«зависать». По логу MM:
+
+* `AT+SFUN=4` отправляется сразу на оба слота; модем0 отвечает на него через
+  ~0.6 с;
+* сразу после этого MM делает всю обычную инициализацию на обоих командных
+  каналах одновременно (`CRSM`, `CPOL`, `CLCK` по всем типам блокировок,
+  `CCLK?` и т. д.) и пытается сменить режим SIM2 командой `SPTESTMODE=6,6`
+  (ответ `Operation not allowed`: радио ещё запускается);
+* ровно через ~1 с оба канала (`at1` и `at4`) перестают отвечать **одновременно**
+  (на `AT+CLCK="PU",2` у одного и `AT+CCLK?` у другого), и до конца лога —
+  более трёх минут — не приходит ничего ни на одном канале, даже на `ATZ`.
+
+То есть завис модем целиком, а не один канал. Какая именно команда его
+«убивает», по логу сказать нельзя. Выводы из сравнения с Android:
+
+* Android отправляет `SFUN=4`, и этот вызов занимает **0.5–4 с**; пока он
+  выполняется, основной канал занят, а все остальные запросы (`CLCK`, `CRSM`,
+  `CPIN`, `CCID`…) RIL отправляет **через запасные каналы** (`ch2`/`ch5`).
+* Android опрашивает блокировки только `"SC"` и `"FD"`. MM опрашивал ещё
+  `PS`, `PN`, `PU`, `PP`, `PC` (в старых логах, когда радио ещё было
+  выключено, это работало).
+* Android никогда не меняет режим сети (`SPTESTMODE`) при запуске радио.
+
+Что изменено:
+
+* радио снова включается только при `enable` (как раньше), ранний запуск убран;
+* ICCID читается через `AT+CCID?`, поэтому ранний запуск радио для этого не нужен;
+* блокировки `PS`, `PN`, `PU`, `PP`, `PC` MM больше не запрашивает;
+* смена режима SIM2 (из 2G в автоматический) отложена на 10 с после
+  включения радио;
+* перед `SFUN=4` слот 2 отправляет `AT+SPCARDINFO=2,1,0`, как RIL.
+
+Это **предположения**: наблюдался только факт зависания в этом сочетании
+команд. Если зависание повторится, нужен лог от старта MM до зависания, чтобы
+понять, какая команда стоит прямо перед тишиной.
+
+## 16. Выбор SIM в Gnome Calls
+
+В логах нет попыток звонка, поэтому причину не удалось установить. Что известно:
+
+* оба модема в MM различимы (`Device`: `unisoc-soc-0` / `unisoc-soc-1`,
+  `Model`: `SIM 1` / `SIM 2`), у каждого свой первичный порт и свой объект SIM;
+* голосовые вызовы MM отправляет на первичный порт своего модема (`ATD…`);
+* что звонок из UI уходит «с SIM1», может быть как на стороне Calls (какой
+  источник вызова выбран), так и на стороне модема (на какую SIM он направляет
+  вызов).
+
+Как отличить (надо снять лог при звонке с выбранной SIM2):
+
+```sh
+sudo busctl monitor --system org.freedesktop.ModemManager1 | grep -E 'CreateCall|Start'
+```
+
+и в логе MM (`--debug`) найти строки `processing user request to create voice
+call` и `--> 'ATD...'`: какой модем (`modem0` или `modem1`) и какой порт
+(`wwan0at1` или `wwan0at4`) отправил `ATD`. Затем проверьте напрямую, без
+Calls:
+
+```sh
+mmcli -m <SIM2-модем> --voice-create-call='number=<номер>'
+mmcli -m <SIM2-модем> -o <call> --start
+```
+
+Если звонок уходит с SIM1 и так — проблема в модеме/настройке слота; если
+с SIM2 — проблема в Calls.
+
